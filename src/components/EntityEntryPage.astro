---
import { siteConfig } from '../../config/site';
import ShareButtons from './ShareButtons.astro';

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  lang: 'ar' | 'en';
  eyebrow: string;
  title: string;
  summary?: string;
  badges?: string[];
  metaItems?: MetaItem[];
  backHref: string;
  backLabel: string;
  externalUrl?: string;
  externalLabel?: string;
}

const {
  lang,
  eyebrow,
  title,
  summary,
  badges = [],
  metaItems = [],
  backHref,
  backLabel,
  externalUrl,
  externalLabel,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
---

<main class="page-main page-main--detail">
  <section class="shell hero hero--detail">
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1 class="hero__title">{title}</h1>
    {summary && <p class="hero__lead">{summary}</p>}

    {badges.length > 0 && (
      <div class="hero__badge-row">
        {badges.map((badge) => (
          <span class="hero__badge">{badge}</span>
        ))}
      </div>
    )}
    <ShareButtons lang={lang} url={pageUrl} title={title} />
  </section>

  <section class="shell entity-grid">
    <article class="entity-summary">
      <slot />
      <div class="entity-share">
        <ShareButtons lang={lang} url={pageUrl} title={title} />
      </div>
    </article>

    <aside class="entity-panel">
      <p class="entity-kicker">{lang === 'ar' ? 'بيانات العمل' : 'Details'}</p>
      <ul class="entity-list">
        {metaItems.filter((item) => item.value).map((item) => (
          <li><strong>{item.label}:</strong> {item.value}</li>
        ))}
        {externalUrl && (
          <li>
            <strong>{lang === 'ar' ? 'الرابط' : 'Link'}:</strong> <a href={externalUrl}>{externalLabel ?? externalUrl}</a>
          </li>
        )}
        <li>
          <a href={backHref}>{backLabel}</a>
        </li>
      </ul>
    </aside>
  </section>
</main>
