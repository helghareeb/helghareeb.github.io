---
// The DSA27 midterm simulator. Every paper is drawn in the browser from the weekly question-bank
// files (src/data/quizzes/dsa27/weekNN.json) for weeks 1 to MIDTERM_LAST_WEEK. Attempts, history and
// per-question statistics stay in localStorage on the student's device.
import { midtermWeeks } from '../utils/quizzes';

interface Props {
  lang: 'ar' | 'en';
}

const { lang } = Astro.props;
const weeks = midtermWeeks();

const L = {
