---
import { hadithLabels, hadithPath, num, type Hadith } from '../utils/hadith';
import HadithText from './HadithText.astro';
import { getFileDownloadUrl } from '../utils/videos';

interface Props {
  lang: 'ar' | 'en';
  book: { id: string; ar: string; en: string };
  h: Hadith;
  full?: boolean; // the hadith's own page: show the empty sharh/fawaid slots too
}

const { lang, book, h, full = false } = Astro.props;
const t = hadithLabels[lang];
const mail = `mailto:helghareeb@gmail.com?subject=${encodeURIComponent(`${book.ar} ${h.n}`)}`;
---

<article class="content-card hadith-card" id={`h${h.n}`}>
  <header class="hadith-card__head">
    <a class="hadith-card__num" href={hadithPath(lang, book.id, h.n)}>{book[lang]} · {num(lang, h.n)}</a>
    <button type="button" class="button-secondary" data-reading-path={hadithPath(lang, book.id, h.n)} data-reading-title={`${book[lang]} · ${num(lang,h.n)}`} aria-pressed="false">{lang === 'ar' ? 'تمت القراءة' : 'Mark as read'}</button>
    {h.grade[lang] && <span class="hadith-card__grade">{t.grade}: {h.grade[lang]}</span>}
  </header>

  {h.bab.ar && <p class="hadith-card__bab" dir="rtl">{h.bab.ar}</p>}

  <div class="hadith-card__audio">
    {h.audio.id ? (
      <div class="hadith-audio" data-audio-id={h.audio.player ?? h.audio.id} data-player-title={`${book[lang]} · ${t.hadith(h.n)}`}>
        <div class="hadith-audio__toolbar">
          <button type="button" class="button hadith-audio__play" aria-expanded="false" aria-controls={`audio-${book.id}-${h.n}`} data-open-label={t.listen} data-close-label={lang === 'ar' ? 'إغلاق المشغّل' : 'Close player'}>
            <span aria-hidden="true">▶</span> <span data-play-label>{t.listen}</span>
          </button>
          <a class="hadith-audio__download" href={getFileDownloadUrl(h.audio.id)} target="_blank" rel="noopener noreferrer">{lang === 'ar' ? 'تحميل الصوت MP3 ↓' : 'Download MP3 ↓'}</a>
          <a class="hadith-audio__external" href={`https://drive.google.com/file/d/${h.audio.player ?? h.audio.id}/view`} target="_blank" rel="noopener noreferrer">{lang === 'ar' ? 'فتح في Drive ↗' : 'Open in Drive ↗'}</a>
        </div>
        {h.audio.reader[lang] && <span class="content-card__meta hadith-audio__reader">{t.reader}: {h.audio.reader[lang]}</span>}
        <div class="hadith-audio__frame" id={`audio-${book.id}-${h.n}`} hidden></div>
      </div>
    ) : (
      <p class="content-card__meta">{h.audio.reader[lang] ? `${t.reader}: ${h.audio.reader[lang]} — ` : ''}{t.audioSoon}</p>
    )}
  </div>

  {h.video?.id && (
    <section class="hadith-card__slot hadith-selected-video" aria-label={lang === 'ar' ? 'فيديو الحديث ونسخ التحميل' : 'Hadith video and downloads'}>
      <h4>{lang === 'ar' ? 'فيديو الحديث' : 'Hadith video'}</h4>
      <div class="hadith-audio" data-audio-id={h.video.id} data-player-title={`${book[lang]} · ${t.hadith(h.n)} · ${lang === 'ar' ? 'فيديو' : 'Video'}`}>
        <div class="hadith-audio__toolbar">
          <button type="button" class="button hadith-audio__play" aria-expanded="false" aria-controls={`video-${book.id}-${h.n}`} data-open-label={lang === 'ar' ? 'مشاهدة الفيديو' : 'Watch video'} data-close-label={lang === 'ar' ? 'إغلاق الفيديو' : 'Close video'}>
            <span aria-hidden="true">▶</span> <span data-play-label>{lang === 'ar' ? 'مشاهدة الفيديو' : 'Watch video'}</span>
          </button>
          <a class="hadith-audio__download" href={getFileDownloadUrl(h.video.id)} target="_blank" rel="noopener noreferrer">{lang === 'ar' ? 'تحميل الفيديو الأفقي ↓' : 'Download landscape video ↓'}</a>
          {h.video.shorts && <a class="hadith-audio__download" href={getFileDownloadUrl(h.video.shorts)} target="_blank" rel="noopener noreferrer">{lang === 'ar' ? 'تحميل الشورت الرأسي ↓' : 'Download vertical short ↓'}</a>}
          {h.video.whatsapp && <a class="hadith-audio__download" href={getFileDownloadUrl(h.video.whatsapp)} target="_blank" rel="noopener noreferrer">{lang === 'ar' ? 'تحميل حالة واتساب ↓' : 'Download WhatsApp status ↓'}</a>}
        </div>
        <div class="hadith-audio__frame" id={`video-${book.id}-${h.n}`} hidden></div>
      </div>
    </section>
  )}

  <div class="hadith-card__text" dir="rtl" lang="ar">
    {h.isnad && (
      <p class="hadith-card__isnad">
        <HadithText text={h.isnad} gharib={h.gharib} quran={h.quran} />
      </p>
    )}
    <p class="hadith-card__matn">
      <HadithText text={h.matn} gharib={h.gharib} quran={h.quran} />
    </p>
    {h.quran?.length && <p class="content-card__meta">{h.quran.map((q,i) => <>{i ? '؛ ' : ''}<span>{q.reference}</span></>)} — النص القرآني بالرسم العثماني من <a href="https://qurancomplex.gov.sa/quran-dev/" target="_blank" rel="noopener noreferrer">مجمع الملك فهد لطباعة المصحف الشريف</a>.</p>}
  </div>

  {h.gharib.length > 0 && (
    <details class="hadith-card__gharib" open={full}>
      <summary>{t.gharib} ({num(lang, h.gharib.length)})</summary>
      <dl dir="rtl" lang="ar">
        {h.gharib.map((g) => (
          <div>
            <dt>{g.word}</dt>
            <dd>{g.meaning} {g.source && <span class="content-card__meta">({g.source})</span>}</dd>
          </div>
        ))}
      </dl>
    </details>
  )}

  {(h.sharh || full) && (
    <section class={`hadith-card__slot${h.sharh ? '' : ' hadith-card__slot--empty'}`}>
      <h4>{t.sharh}{h.sharh && h.notesStatus === 'review' && <span class="hadith-card__review">{t.review}</span>}</h4>
      <p dir="rtl" lang="ar">{h.sharh ? h.sharh.ar : t.soon}</p>
      {h.sharh?.source && <p class="content-card__meta" dir="rtl" lang="ar">{h.sharh.source}</p>}
    </section>
  )}
  {(h.fawaid.length > 0 || full) && (
    <section class={`hadith-card__slot${h.fawaid.length ? '' : ' hadith-card__slot--empty'}`}>
      <h4>{t.fawaid}{h.fawaid.length > 0 && h.notesStatus === 'review' && <span class="hadith-card__review">{t.review}</span>}</h4>
      {h.fawaid.length ? <ol dir="rtl" lang="ar">{h.fawaid.map((f) => <li>{f.ar}</li>)}</ol> : <p>{t.soon}</p>}
    </section>
  )}

  <details class="hadith-card__en" open={lang === 'en'}>
    <summary>{t.english}</summary>
    <p dir="ltr" lang="en">{h.en.narrator && <strong>Narrated {h.en.narrator}: </strong>}{h.en.text}</p>
    <p class="content-card__meta" dir="ltr">{h.en.source}</p>
  </details>

  <footer class="hadith-card__foot">
    <span class="content-card__meta">{t.takhrij}: {h.takhrij[lang]}</span>
    <span class="hadith-card__actions">
      <a class="video-card__share" href={mail}>{t.report}</a>
    </span>
  </footer>
</article>
