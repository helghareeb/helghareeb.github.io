---
import { navigation } from '../../config/navigation';
import { siteConfig } from '../../config/site';
import VisitCounter from './VisitCounter.astro';

interface Props {
  lang: 'ar' | 'en';
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const links = navigation[lang];
const siteName = lang === 'ar' ? siteConfig.nameAr : siteConfig.nameEn;
const description =
  lang === 'ar'
    ? 'مؤلفات الدكتور هيثم عبدالمنعم الغريب ومقالاته وتحقيقاته ومواد المذاكرة لطالب العلم، إلى جانب سيرته العلمية في نظم المعلومات بجامعة المنصورة.'
    : 'Books, articles, critical editions and study materials by Dr. Haitham A. El-Ghareeb, Associate Professor of Information Systems at Mansoura University.';
const quickLinks = links.slice(0, 6);
const extendedLinks = links.slice(6);
const siteIndexLink = lang === 'ar' ? '/ar/site-map/' : '/en/site-map/';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <section>
      <p class="footer-kicker">{lang === 'ar' ? 'عن الموقع' : 'About'}</p>
      <h2 class="footer-title">{siteName}</h2>
      <p class="footer-copy">{description}</p>
    </section>

    <section>
      <p class="footer-kicker">{lang === 'ar' ? 'روابط سريعة' : 'Quick links'}</p>
      <div class="footer-links">
        {quickLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <section>
      <p class="footer-kicker">{lang === 'ar' ? 'أقسام أخرى' : 'More sections'}</p>
      <div class="footer-links">
        {extendedLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href={siteIndexLink}>{lang === 'ar' ? 'دليل الموقع' : 'Site Index'}</a>
      </div>
    </section>

    <section>
      <p class="footer-kicker">{lang === 'ar' ? 'تواصل' : 'Contact'}</p>
      <div class="footer-links">
        <a href="mailto:helghareeb@mans.edu.eg">helghareeb@mans.edu.eg</a>
        <a href="https://scholar.google.com/citations?user=f66uaewAAAAJ">Google Scholar</a>
        <a href="https://orcid.org/0000-0003-1875-6706">ORCID</a>
        <a href="https://github.com/helghareeb">GitHub</a>
      </div>
    </section>
  </div>

  <div class="shell site-footer__bottom">
    <p>{siteName}</p>
    <VisitCounter lang={lang} currentPath={currentPath} />
    <p>{year}</p>
  </div>
</footer>
