---
import { navigation } from '../../config/navigation';
import { siteConfig } from '../../config/site';
import { getAlternateLocalePath } from '../utils/locale-switch';

interface Props {
  lang: 'ar' | 'en';
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const links = navigation[lang];
const primaryLinks = links.slice(0, 6);
const secondaryLinks = links.slice(6);
const switchLocalePath = await getAlternateLocalePath(currentPath, lang);

const homeHref = lang === 'ar' ? '/ar/' : '/en/';
const siteIndexHref = lang === 'ar' ? '/ar/site-map/' : '/en/site-map/';
const searchHref = lang === 'ar' ? '/ar/search/' : '/en/search/';
const isSearchActive = currentPath === searchHref || currentPath === searchHref.slice(0, -1);
const siteName = lang === 'ar' ? siteConfig.nameAr : siteConfig.nameEn;
const languageLabel = lang === 'ar' ? 'English' : 'العربية';
const languageAria = lang === 'ar' ? 'الانتقال إلى النسخة الإنجليزية' : 'Switch to Arabic version';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <div class="site-header__brand">
      <a class="site-brand" href={homeHref}>
        <span class="site-brand__eyebrow">{lang === 'ar' ? 'موقع علمي شخصي' : 'Personal Scholarly Website'}</span>
        <span class="site-brand__title">{siteName}</span>
      </a>
    </div>

    <details class="site-header__menu">
      <summary class="site-header__toggle">
        <span>{lang === 'ar' ? 'القائمة' : 'Menu'}</span>
      </summary>

      <div class="site-header__controls">
        <nav class="site-nav-group" aria-label={lang === 'ar' ? 'التنقل الرئيسي' : 'Main navigation'}>
          <div class="site-nav site-nav--primary">
            {primaryLinks.map((link) => {
              const isActive = currentPath === link.href || currentPath === link.href.slice(0, -1);

              return (
                <a class:list={['site-nav__link', { 'is-active': isActive }]} href={link.href}>
                  {link.label}
                </a>
              );
            })}
          </div>

          <div class="site-nav site-nav--secondary">
            {secondaryLinks.map((link) => {
              const isActive = currentPath === link.href || currentPath === link.href.slice(0, -1);

              return (
                <a class:list={['site-nav__link', 'site-nav__link--secondary', { 'is-active': isActive }]} href={link.href}>
                  {link.label}
                </a>
              );
            })}
          </div>
        </nav>

        <div class="site-header__utilities">
          <div class="site-header__utility-row">
            <a
              class:list={['site-index-link', 'site-search-link', { 'is-active': isSearchActive }]}
              href={searchHref}
              aria-current={isSearchActive ? 'page' : undefined}
              title={lang === 'ar' ? 'البحث في الموقع' : 'Search the site'}
            >
              <svg class="site-search-link__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span class="site-search-link__label">{lang === 'ar' ? 'البحث' : 'Search'}</span>
            </a>

            <a class="site-index-link" href={siteIndexHref}>
              {lang === 'ar' ? 'دليل الموقع' : 'Site Index'}
            </a>
          </div>

          <a class="locale-switch" href={switchLocalePath} aria-label={languageAria}>
            {languageLabel}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
