---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout lang="ar" dir="rtl" title="الصفحة غير موجودة | د. هيثم الغريب" noindex>
  <main class="page-main">
    <section class="shell hero">
      <p class="hero__eyebrow">404</p>
      <h1 class="hero__title">الصفحة غير موجودة</h1>
      <p class="hero__lead">
        لعل الرابط تغيّر أو كُتب بصورة غير صحيحة. يمكنك البدء من الصفحة الرئيسية أو من دليل الموقع.
      </p>
      <div class="hero__actions">
        <a class="button" href="/ar/">الصفحة الرئيسية</a>
        <a class="button-secondary" href="/ar/site-map/">دليل الموقع</a>
      </div>
      <p class="hero__lead" dir="ltr" lang="en">
        This page could not be found. <a href="/en/">Go to the English home page</a> or the
        <a href="/en/site-map/">site index</a>.
      </p>
    </section>
  </main>
</BaseLayout>
