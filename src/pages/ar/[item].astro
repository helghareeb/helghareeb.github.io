---
import HadithCard from '../../components/HadithCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { siteConfig } from '../../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../utils/seo';
import { books, HADITH_BOOK, hadithLabels, hadithPath, kitabPath, num, type Book, type Hadith, type Kitab } from '../../utils/hadith';

// A hadith book site (HADITH_BOOK=<book>): its kutub and hadith at /hadith-<book>/ar/<kitab or number>/.
// The main site builds none of these.
export function getStaticPaths() {
  return books.filter((b) => b.book.id === HADITH_BOOK).flatMap((b) =>
    b.kutub.flatMap((k) => [
      { params: { item: k.slug }, props: { b, k, h: null } },
      ...k.hadith.map((h) => ({ params: { item: String(h.n) }, props: { b, k, h } })),
    ]),
  );
}

const { b, k, h } = Astro.props as { b: Book; k: Kitab; h: Hadith | null };
const t = hadithLabels.ar;
const title = h ? `${b.book.ar} ${num('ar', h.n)}` : `${k.ar} — ${b.book.ar}`;
const seoTitle = buildSeoTitle(title, { lang: 'ar', section: t.section });
const seoDescription = buildSeoDescription(h ? h.matn.slice(0, 160) : k.ar, h ? [h.takhrij.ar] : k.hadith.map((x) => x.matn.slice(0, 40)));
const i = h ? k.hadith.findIndex((x) => x.n === h.n) : -1;
const prev = h && i > 0 ? k.hadith[i - 1] : null;
const next = h && i < k.hadith.length - 1 ? k.hadith[i + 1] : null;
const crumbs = [
  { href: '/ar/hadith/', label: t.section },
  ...(h ? [{ href: kitabPath('ar', b.book.id, k.slug), label: k.ar }] : []),
  { href: Astro.url.pathname, label: h ? t.hadith(h.n) : k.ar },
];
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription} crumbs={crumbs}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow"><a href="/ar/hadith/">{t.section}</a> · {b.book.ar}</p>
      <h1 class="hero__title">{h ? t.hadith(h.n) : k.ar}</h1>
      {h ? <p class="hero__lead"><a href={kitabPath('ar', b.book.id, k.slug)}>{k.ar}</a></p> : <p class="hero__lead">{t.count(k.hadith.length)}</p>}
      <ShareButtons lang="ar" url={new URL(Astro.url.pathname, siteConfig.siteUrl).toString()} title={title} />
    </section>
    <section class="shell section hadith-list">
      {h ? <HadithCard lang="ar" book={b.book} h={h} full /> : k.hadith.map((x) => <HadithCard lang="ar" book={b.book} h={x} />)}
      {h && (
        <nav class="hero__actions">
          {prev && <a class="button-secondary" href={hadithPath('ar', b.book.id, prev.n)}>{t.hadith(prev.n)}</a>}
          {next && <a class="button-secondary" href={hadithPath('ar', b.book.id, next.n)}>{t.hadith(next.n)}</a>}
        </nav>
      )}
    </section>
  </main>
</BaseLayout>

<div class="gharib-pop" role="tooltip" hidden></div>
<script>
  // Tap a gold-underlined word to see its meaning.
  const pop = document.querySelector<HTMLElement>('.gharib-pop')!;
  document.querySelectorAll<HTMLButtonElement>('button.gharib').forEach((b) => {
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      pop.innerHTML = '';
      const w = document.createElement('strong'); w.textContent = b.textContent ?? '';
      const m = document.createElement('p'); m.textContent = b.dataset.meaning ?? '';
      const s = document.createElement('small'); s.textContent = b.dataset.source ?? '';
      pop.append(w, m, s);
      const r = b.getBoundingClientRect();
      pop.style.top = `${window.scrollY + r.bottom + 8}px`;
      pop.style.left = `${Math.max(8, Math.min(window.innerWidth - 328, window.scrollX + r.left + r.width / 2 - 160))}px`;
      pop.hidden = false;
    });
  });
  document.addEventListener('click', () => (pop.hidden = true));

  // Audio: open Drive's player for one hadith at a time; opening another closes (and so stops) the rest.
  document.querySelectorAll<HTMLElement>('.hadith-audio').forEach((box) => {
    box.querySelector('button')!.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.hadith-audio.is-open').forEach((other) => {
        other.querySelector('iframe')?.remove();
        other.classList.remove('is-open');
      });
      const frame = document.createElement('iframe');
      frame.src = `https://drive.google.com/file/d/${box.dataset.audioId}/preview`;
      frame.allow = 'autoplay; fullscreen';
      frame.title = box.querySelector('button')!.textContent ?? '';
      box.append(frame);
      box.classList.add('is-open');
    });
  });
</script>
