---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';

const interests = [
  {
    title: 'أصول الفقه و«الرسالة»',
    copy: 'ملخصات شروح «الرسالة» للإمام الشافعي دروسًا متتابعة، وتفريغات منقحة لشروحها، ودفاتر فوائد مستخلصة منها.',
    href: '/ar/fields/islamic-studies/',
  },
  {
    title: 'علوم المخطوطات والتحقيق',
    copy: 'ملخصات دورات الشيخ صالح الأزهري في علوم المخطوطات، وتحقيق «التوضيح للأوهام الواقعة في الصحيح» لسبط ابن العجمي.',
    href: '/ar/fields/manuscripts/',
  },
  {
    title: 'الدفاع عن السنة: سلسلة الميزان',
    copy: 'سلسلة «الميزان: كيف نزن الشبهات» ومقالات في الذب عن «صحيح البخاري» والرد على شبهات الحداثة.',
    href: '/ar/fields/defense-of-sunnah/',
  },
  {
    title: 'الذكاء الاصطناعي والتراث الإسلامي',
    copy: 'توظيف أدوات نظم المعلومات والذكاء الاصطناعي في خدمة العلوم الشرعية، كتحليل العلاقات بين رواة الحديث بالخوارزميات.',
    href: '/ar/fields/ai-and-islamic-heritage/',
  },
  {
    title: 'التعليم الإلكتروني',
    copy: 'كتب في المعمارية الموجهة للخدمات لدعم التعليم الإلكتروني، وبطاقات مذاكرة تفاعلية لطالب العلم الشرعي.',
    href: '/ar/fields/e-learning/',
  },
  {
    title: 'التحرير والتحكيم العلمي',
    copy: 'إدارة تحرير مجلة المنصورة لعلوم الحاسبات والمعلومات، وتحكيم البحوث، والمشاركة في لجان مناقشة الرسائل.',
    href: '/ar/fields/academic-reviewing/',
  },
];
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="نبذة | د. هيثم الغريب"
  description="د. هيثم عبدالمنعم الغريب، أستاذ نظم المعلومات المساعد بجامعة المنصورة ومدير تحرير مجلة المنصورة لعلوم الحاسبات والمعلومات، وطالب علم شرعي."
>
  <main class="page-main">
    <section class="shell hero">
      <p class="hero__eyebrow">نبذة</p>
      <h1 class="hero__title">د. هيثم عبدالمنعم الغريب</h1>
      <p class="hero__lead">
        أستاذ نظم المعلومات المساعد بكلية الحاسبات والمعلومات بجامعة المنصورة، ومدير تحرير
        مجلة المنصورة لعلوم الحاسبات والمعلومات، يجمع بين البحث في نظم المعلومات وطلب العلم
        الشرعي وخدمته تأليفًا وتلخيصًا وتحقيقًا.
      </p>

      <div class="hero__actions">
        <a class="button" href="/ar/cv/">السيرة الذاتية</a>
        <a class="button-secondary" href="/ar/contact/">تواصل</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        <article class="content-card">
          <p class="content-card__meta">المسار الأكاديمي</p>
          <h2 class="section-title">نظم المعلومات</h2>
          <p>
            تخرج في قسم نظم المعلومات بكلية الحاسبات والمعلومات، جامعة المنصورة، سنة 2004م،
            ونال منها درجة الماجستير سنة 2008م، ثم الدكتوراه سنة 2011م. عُيّن معيدًا بالقسم
            سنة 2005م، فمدرسًا مساعدًا سنة 2008م، فمدرسًا سنة 2012م، وهو أستاذ مساعد منذ
            2019م. وأُعير إلى جامعة الزلفي بالمملكة العربية السعودية أستاذًا مساعدًا لنظم
            المعلومات بقسم علوم الحاسب من 2015م إلى 2017م.
          </p>
          <p>
            يشغل منصب مدير تحرير مجلة المنصورة لعلوم الحاسبات والمعلومات (MJCIS) منذ 24 سبتمبر
            2026م، وهو عضو في هيئة تحريرها منذ أبريل 2023م. ومن مجالات بحثه نظم المعلومات
            الذكية، والعمارة المؤسسية والتكامل المؤسسي، والتعليم الإلكتروني، والذكاء الاصطناعي
            والحوسبة السحابية.
          </p>
        </article>
        <article class="content-card">
          <p class="content-card__meta">طلب العلم الشرعي</p>
          <h2 class="section-title">في صحبة أهل العلم</h2>
          <p>
            حنبلي المذهب، سلفي المنهج على جادة أهل السنة والجماعة. شرف بالحضور لعدد من أهل
            العلم، منهم الأستاذ الدكتور أحمد عبدالرحمن النقيب، والشيخ مصطفى بن العدوي، والشيخ
            أبو حفص سامي بن العربي، وانتفع عن بعد بدروس آخرين، منهم الشيخ أبو إسحاق الحويني
            والشيخ صالح العصيمي.
          </p>
          <p>
            أتم الدراسة في أكاديمية زاد، والبرنامج الأساسي في أكاديمية تفسير، ويدرس في السنة
            الثانية بأكاديمية مرتقى للعلوم الشرعية، وفي المرحلة الأخيرة من برنامج التأهيل الفقهي
            على المذهب الحنبلي. ويسعى إلى توظيف تخصصه في التقنية لخدمة العلم الشرعي وتنظيمه
            وتيسير الوصول إليه.
          </p>
        </article>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">مجالات الاهتمام</p>
        <h2 class="section-title">ما تجده في هذا الموقع</h2>
      </div>

      <div class="grid-three">
        {interests.map((item) => (
          <a class="card-link" href={item.href}>
            <article class="feature-card">
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
