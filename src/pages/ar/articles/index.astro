---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getArticleSeriesPath, getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const articleForms: [string, string, string, string, string] = ['مقال واحد', 'مقالان', 'مقالات', 'مقالًا', 'مقال'];
const seriesForms: [string, string, string, string, string] = ['سلسلة واحدة', 'سلسلتان', 'سلاسل', 'سلسلةً', 'سلسلة'];
const partForms: [string, string, string, string, string] = ['حلقة واحدة', 'حلقتان', 'حلقات', 'حلقةً', 'حلقة'];

const byDateDesc = (a: { data: { date?: string } }, b: { data: { date?: string } }) => {
  const aTime = a.data.date ? new Date(a.data.date).getTime() : 0;
  const bTime = b.data.date ? new Date(b.data.date).getTime() : 0;

  return bTime - aTime;
};

const allArticles = (await getCollection('articles'))
  .filter((entry) => entry.data.lang === 'ar' && !entry.data.draft)
  .sort(byDateDesc);

const latestArticles = allArticles.slice(0, 12);
const alukahCount = allArticles.filter((entry) => entry.data.sourceName === 'شبكة الألوكة').length;

const seriesMap = new Map<string, { title: string; slug: string; count: number }>();

for (const article of allArticles) {
  if (!article.data.series || !article.data.seriesSlug) continue;

  const existing = seriesMap.get(article.data.seriesSlug);

  if (existing) {
    existing.count += 1;
  } else {
    seriesMap.set(article.data.seriesSlug, {
      title: article.data.series,
      slug: article.data.seriesSlug,
      count: 1,
    });
  }
}

const largestSeries = Array.from(seriesMap.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);

const categoryMap = new Map<string, typeof allArticles>();

for (const article of allArticles) {
  const category = article.data.category ?? 'مقالات متنوعة';
  categoryMap.set(category, [...(categoryMap.get(category) ?? []), article]);
}

const categories = Array.from(categoryMap.entries()).sort((a, b) => b[1].length - a[1].length);

const seoTitle = buildSeoTitle('المقالات', {
  lang: 'ar',
  section: 'المقالات',
});
const seoDescription = buildSeoDescription(
  'مقالات في أصول الفقه والحديث والعقيدة والتفسير وعلوم المخطوطات والدعوة، وشروح وملخصات منشورة في الألوكة ومنصات أخرى.',
  [
    countAr(allArticles.length, articleForms),
    countAr(seriesMap.size, seriesForms),
    latestArticles[0]?.data.date ? `آخر مقال ${latestArticles[0].data.date}` : undefined,
  ],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">المقالات</p>
      <h1 class="hero__title">المقالات</h1>
      <p class="hero__lead">
        {countAr(allArticles.length, articleForms)} في أصول الفقه والحديث والعقيدة والتفسير وعلوم
        المخطوطات والدعوة، منها {countAr(alukahCount, articleForms)} في شبكة الألوكة، و{countAr(seriesMap.size, seriesForms)}
        تُقرأ حلقاتها متتابعة.
      </p>

      <div class="hero__actions">
        <a class="button" href="/ar/articles/series/">سلاسل المقالات</a>
        <a class="button-secondary" href="/ar/fields/alukah/articles/">مقالات الألوكة</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">الأحدث</p>
        <h2 class="section-title">أحدث المقالات</h2>
      </div>

      <div class="grid-two">
        {latestArticles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'ar', article.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[article.data.category, article.data.date].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
              <p class="content-card__meta">
                {[article.data.series, article.data.readingTime].filter(Boolean).join(' | ')}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>

    {largestSeries.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">السلاسل</p>
          <h2 class="section-title">أكبر السلاسل</h2>
        </div>

        <div class="grid-two">
          {largestSeries.map((series) => (
            <a class="card-link" href={getArticleSeriesPath('ar', series.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{countAr(series.count, partForms)}</p>
                <h3>{series.title}</h3>
              </article>
            </a>
          ))}
        </div>

        <div class="hero__actions">
          <a class="button-secondary" href="/ar/articles/series/">كل السلاسل</a>
        </div>
      </section>
    )}

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">الأرشيف</p>
        <h2 class="section-title">كل المقالات بحسب التصنيف</h2>
      </div>

      <div class="grid-two">
        {categories.map(([category, entries]) => (
          <details class="content-card entity-card" id={`category-${category.replace(/\s+/g, '-')}`}>
            <summary><strong>{category}</strong> ({entries.length})</summary>
            <ul class="list-clean" style="margin-top: 0.9rem;">
              {entries.map((article) => (
                <li>
                  <a href={getEntryPath('articles', 'ar', article.slug)}>{article.data.title}</a>
                  {article.data.date && <span class="content-card__meta"> · {article.data.date}</span>}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
