---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getEntryPath } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { seriesIntroLead, seriesIntrosAr } from '../../../../../config/series-intros';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter(
    (entry) => entry.data.lang === 'ar' && !entry.data.draft && entry.data.series && entry.data.seriesSlug,
  );

  const seriesMap = new Map<string, { title: string }>();

  for (const article of articles) {
    const slug = article.data.seriesSlug!;
    if (!seriesMap.has(slug)) {
      seriesMap.set(slug, { title: article.data.series! });
    }
  }

  return Array.from(seriesMap.entries()).map(([series, data]) => ({
    params: { series },
    props: { seriesSlug: series, seriesTitle: data.title },
  }));
}

const { seriesSlug, seriesTitle } = Astro.props;
const seriesArticles = (await getCollection('articles'))
  .filter(
    (entry) =>
      entry.data.lang === 'ar' &&
      !entry.data.draft &&
      entry.data.seriesSlug === seriesSlug,
  )
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

const firstArticle = seriesArticles[0];
const seriesDates = seriesArticles.map((article) => article.data.date).filter((date): date is string => Boolean(date)).sort();
const firstDate = seriesDates[0];
const lastDate = seriesDates[seriesDates.length - 1];
const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const partForms: [string, string, string, string, string] = ['حلقة واحدة', 'حلقتان', 'حلقات', 'حلقةً', 'حلقة'];
const sourceLabel = firstArticle?.data.sourceName;
const seriesIntro = seriesIntrosAr[seriesSlug];
const seoTitle = buildSeoTitle(seriesTitle, { lang: 'ar', section: 'السلاسل المقالية' });
const seoDescription = buildSeoDescription(
  seriesIntroLead(seriesIntro) ?? `حلقات سلسلة «${seriesTitle}» مرتبة بحسب تسلسلها.`,
  [
    countAr(seriesArticles.length, partForms),
    firstArticle?.data.category,
    lastDate ? `آخر حلقة ${lastDate}` : undefined,
  ],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">سلسلة مقالات</p>
      <h1 class="hero__title">{seriesTitle}</h1>
      {seriesIntro ? (
        <p class="hero__lead">{seriesIntro}</p>
      ) : (
        <p class="hero__lead">
          {countAr(seriesArticles.length, partForms)}{firstArticle?.data.category && ` في ${firstArticle.data.category}`}{sourceLabel && `، نُشرت أولًا في ${sourceLabel}`}، مرتبة بحسب تسلسلها.
        </p>
      )}

      <div class="hero__badge-row">
        {seriesIntro && <span class="hero__badge">{countAr(seriesArticles.length, partForms)}</span>}
        {seriesIntro && sourceLabel && <span class="hero__badge">{sourceLabel}</span>}
        {firstArticle?.data.category && <span class="hero__badge">{firstArticle.data.category}</span>}
        {firstDate && <span class="hero__badge">من {firstDate}</span>}
        {lastDate && lastDate !== firstDate && <span class="hero__badge">إلى {lastDate}</span>}
      </div>
    </section>

    <section class="shell section">
      {seriesSlug === 'al-risala-ahmad-naqeeb' && (
        <article class="notice-card">
          <p>الدرس الثالث والستون غير متاح في مصدره الأصلي، فلم يُلخَّص.</p>
        </article>
      )}

      <div class="section-heading">
        <p class="section-kicker">حلقات السلسلة</p>
        <h2 class="section-title">الترتيب الكامل</h2>
      </div>

      <div class="grid-two">
        {seriesArticles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'ar', article.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[article.data.date, article.data.readingTime].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
