---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getArticleSeriesPath } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { seriesIntroLead, seriesIntrosAr } from '../../../../../config/series-intros';

const articles = (await getCollection('articles')).filter(
  (entry) => entry.data.lang === 'ar' && !entry.data.draft && entry.data.series && entry.data.seriesSlug,
);

const seriesMap = new Map<
  string,
  {
    title: string;
    slug: string;
    count: number;
    latestDate?: string;
    latestTitle?: string;
    category?: string;
  }
>();

for (const article of articles) {
  const slug = article.data.seriesSlug!;
  const existing = seriesMap.get(slug);

  if (!existing) {
    seriesMap.set(slug, {
      title: article.data.series!,
      slug,
      count: 1,
      latestDate: article.data.date,
      latestTitle: article.data.title,
      category: article.data.category,
    });
    continue;
  }

  existing.count += 1;

  const existingTime = existing.latestDate ? new Date(existing.latestDate).getTime() : 0;
  const articleTime = article.data.date ? new Date(article.data.date).getTime() : 0;

  if (articleTime >= existingTime) {
    existing.latestDate = article.data.date;
    existing.latestTitle = article.data.title;
    existing.category = article.data.category;
  }
}

const seriesEntries = Array.from(seriesMap.values()).sort((a, b) => {
  const aTime = a.latestDate ? new Date(a.latestDate).getTime() : 0;
  const bTime = b.latestDate ? new Date(b.latestDate).getTime() : 0;

  return bTime - aTime;
});
const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const partForms: [string, string, string, string, string] = ['حلقة واحدة', 'حلقتان', 'حلقات', 'حلقةً', 'حلقة'];
const seriesForms: [string, string, string, string, string] = ['سلسلة واحدة', 'سلسلتان', 'سلاسل', 'سلسلةً', 'سلسلة'];
const seoTitle = buildSeoTitle('سلاسل المقالات', {
  lang: 'ar',
  section: 'السلاسل المقالية',
});
const seoDescription = buildSeoDescription(
  'سلاسل مقالات في شروح الرسالة للإمام الشافعي، ودورات علوم المخطوطات للشيخ صالح الأزهري، وملخصات الكتب، والرد على الشبهات.',
  [
    countAr(seriesEntries.length, seriesForms),
    seriesEntries[0]?.latestDate ? `آخر تحديث ${seriesEntries[0].latestDate}` : undefined,
  ],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">سلاسل المقالات</p>
      <h1 class="hero__title">سلاسل المقالات</h1>
      <p class="hero__lead">
        {countAr(seriesEntries.length, seriesForms)} تُقرأ حلقاتها متتابعة: شروح «الرسالة» للإمام الشافعي،
        ودورات الشيخ صالح الأزهري في علوم المخطوطات، وملخصات كتب، وسلاسل في التفسير والتزكية والرد على الشبهات.
      </p>

      <div class="hero__actions">
        <a class="button-secondary" href="/ar/articles/">كل المقالات</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {seriesEntries.map((series) => (
          <a class="card-link" href={getArticleSeriesPath('ar', series.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[series.category, countAr(series.count, partForms)].filter(Boolean).join(' | ')}
              </p>
              <h3>{series.title}</h3>
              {seriesIntrosAr[series.slug] ? (
                <p>{seriesIntroLead(seriesIntrosAr[series.slug])}</p>
              ) : (
                series.latestTitle && <p>أحدث حلقة: {series.latestTitle}</p>
              )}
              {series.latestDate && <p class="content-card__meta">آخر حلقة {series.latestDate}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
