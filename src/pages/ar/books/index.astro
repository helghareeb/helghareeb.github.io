---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const books = (await getCollection('books'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => {
    const yearCompare = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearCompare !== 0) return yearCompare;

    return a.data.title.localeCompare(b.data.title, 'ar');
  });

// Books are grouped by subject; slides stay in their own group at the end.
const SLIDES = 'شرائح عرض';
const groupOrder = ['العقيدة والدعوة', 'القرآن وعلومه', 'أصول الفقه', 'التربية والأدب', 'نظم المعلومات والحوسبة', SLIDES];
const groupId: Record<string, string> = {
  'العقيدة والدعوة': 'creed',
  'القرآن وعلومه': 'quran',
  'أصول الفقه': 'usul',
  'التربية والأدب': 'education',
  'نظم المعلومات والحوسبة': 'computing',
  [SLIDES]: 'slides',
};

const groupMap = new Map<string, typeof books>();
for (const book of books) {
  const key = book.data.workType === SLIDES ? SLIDES : (book.data.category ?? 'أعمال أخرى');
  groupMap.set(key, [...(groupMap.get(key) ?? []), book]);
}

const rank = (key: string) => {
  const index = groupOrder.indexOf(key);
  return index === -1 ? groupOrder.length : index;
};
const groups = Array.from(groupMap.entries())
  .sort((a, b) => rank(a[0]) - rank(b[0]))
  .map(([key, entries]) => ({ key, id: groupId[key] ?? 'other', title: key === SLIDES ? 'شرائح العرض' : key, entries }));

const seoTitle = buildSeoTitle('الكتب', {
  lang: 'ar',
  section: 'الكتب',
});
const seoDescription = buildSeoDescription(
  'كتب ومؤلفات د. هيثم الغريب في العلوم الشرعية والقصة الاجتماعية ونظم المعلومات والتعليم الإلكتروني، مع بيانات النشر وروابط القراءة والتحميل.',
  [books[0]?.data.year ? `أحدثها ${books[0].data.year}` : undefined],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">الكتب</p>
      <h1 class="hero__title">الكتب والمؤلفات</h1>
      <p class="hero__lead">
        مؤلفات في العقيدة وعلوم القرآن وأصول الفقه، وفي التربية والقصة الاجتماعية، وتفريغات منقحة
        لشروح أهل العلم، وكتب أكاديمية في نظم المعلومات، مرتبة حسب الموضوع.
      </p>
    </section>

    <nav class="shell books-nav" aria-label="أقسام الكتب">
      {groups.map((group) => (
        <a class="hero__badge" href={`#${group.id}`}>{group.title} ({group.entries.length + (group.id === 'quran' ? 1 : 0)})</a>
      ))}
    </nav>

    {groups.map((group) => (
      <section class="shell section" id={group.id}>
        <div class="section-heading">
          <h2 class="section-title">{group.title}</h2>
        </div>

        <div class="grid-two">
          {group.id === 'quran' && (
            <a class="card-link" href="/ar/mushaf-gharib/">
              <article class="content-card entity-card">
                <p class="content-card__meta">كتاب · قراءة وتحميل PDF</p>
                <h3>مصحف الغريب</h3>
                <p>
                  مصحف المدينة برواية حفص، تقابل كل صفحة منه صفحة شرح: غريب القرآن من ستة كتب، وأسباب النزول،
                  وأحاديث كتب التفسير بأحكامها. في واحد وثلاثين مجلدًا وملف كامل.
                </p>
              </article>
            </a>
          )}
          {group.entries.map((book) => (
            <a class="card-link" href={getEntryPath('books', 'ar', book.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[book.data.year, book.data.publisher].filter(Boolean).join(' | ')}</p>
                <h3>{book.data.title}</h3>
                <p>{book.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
