---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const books = (await getCollection('books'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => {
    const yearCompare = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearCompare !== 0) return yearCompare;

    return a.data.title.localeCompare(b.data.title, 'ar');
  });

const groupLabels: Record<string, string> = {
  'كتاب': 'الكتب',
  'كتاب إلكتروني': 'الكتب الإلكترونية',
  'شرائح عرض': 'شرائح العرض',
};
const groupOrder = ['كتاب', 'كتاب إلكتروني', 'شرائح عرض'];

const groupMap = new Map<string, typeof books>();
for (const book of books) {
  const key = book.data.workType ?? 'كتاب';
  groupMap.set(key, [...(groupMap.get(key) ?? []), book]);
}

const groups = Array.from(groupMap.entries())
  .sort((a, b) => {
    const aIndex = groupOrder.indexOf(a[0]);
    const bIndex = groupOrder.indexOf(b[0]);

    return (aIndex === -1 ? groupOrder.length : aIndex) - (bIndex === -1 ? groupOrder.length : bIndex);
  })
  .map(([workType, entries]) => ({ title: groupLabels[workType] ?? workType, entries }));

const seoTitle = buildSeoTitle('الكتب', {
  lang: 'ar',
  section: 'الكتب',
});
const seoDescription = buildSeoDescription(
  'كتب ومؤلفات د. هيثم الغريب في العلوم الشرعية والقصة الاجتماعية ونظم المعلومات والتعليم الإلكتروني، مع بيانات النشر وروابط القراءة والتحميل.',
  [books[0]?.data.year ? `أحدثها ${books[0].data.year}` : undefined],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">الكتب</p>
      <h1 class="hero__title">الكتب والمؤلفات</h1>
      <p class="hero__lead">
        مؤلفات في العلوم الشرعية والقصة الاجتماعية، وتفريغات منقحة لشروح أهل العلم، وكتب
        أكاديمية في المعمارية الموجهة للخدمات والتعليم الإلكتروني وتكامل المؤسسات.
      </p>
    </section>

    <section class="shell section">
      <a class="card-link" href="/ar/mushaf-gharib/">
        <article class="content-card entity-card">
          <p class="content-card__meta">كتاب · قراءة وتحميل PDF</p>
          <h3>مصحف الغريب</h3>
          <p>
            مصحف المدينة برواية حفص، تقابل كل صفحة منه صفحة شرح: غريب القرآن من ستة كتب، وأسباب النزول،
            وأحاديث كتب التفسير بأحكامها. في واحد وثلاثين مجلدًا وملف كامل.
          </p>
        </article>
      </a>
    </section>

    {groups.map((group) => (
      <section class="shell section">
        <div class="section-heading">
          <h2 class="section-title">{group.title}</h2>
        </div>

        <div class="grid-two">
          {group.entries.map((book) => (
            <a class="card-link" href={getEntryPath('books', 'ar', book.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[book.data.year, book.data.publisher].filter(Boolean).join(' | ')}</p>
                <h3>{book.data.title}</h3>
                <p>{book.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
