---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const editions = (await getCollection('editions'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0));
const seoTitle = buildSeoTitle('التحقيقات', {
  lang: 'ar',
  section: 'التحقيقات',
});
const seoDescription = buildSeoDescription(
  'نصوص تراثية حققها د. هيثم الغريب عن نسخها الخطية، مع دراسة تمهيدية ووصف للنسخ المعتمدة.',
  editions.map((edition) => edition.data.title),
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">التحقيقات</p>
      <h1 class="hero__title">تحقيق النصوص التراثية</h1>
      <p class="hero__lead">
        نصوص من التراث محققة عن نسخها الخطية، تسبقها دراسة تمهيدية تعرّف بالمؤلف والكتاب
        وتصف النسخ المعتمدة.
      </p>

      <div class="hero__actions">
        <a class="button-secondary" href="/ar/fields/manuscripts/">علوم المخطوطات</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {editions.map((edition) => (
          <a class="card-link" href={getEntryPath('editions', 'ar', edition.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{[edition.data.workType, edition.data.sourceType, edition.data.year].filter(Boolean).join(' | ')}</p>
              <h3>{edition.data.title}</h3>
              <p>{edition.data.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
