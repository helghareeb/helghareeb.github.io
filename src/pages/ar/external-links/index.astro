---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const links = (await getCollection('externalLinks'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;

    return a.data.title.localeCompare(b.data.title, 'ar');
  });
const seoTitle = buildSeoTitle('الروابط الخارجية', {
  lang: 'ar',
  section: 'الروابط الخارجية',
});
const seoDescription = buildSeoDescription(
  'الملفات البحثية والمهنية لد. هيثم الغريب، وصفحاته في منصات النشر، وكتب ومقالات وأخبار أكاديمية منشورة خارج الموقع.',
  [],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">الروابط الخارجية</p>
      <h1 class="hero__title">الروابط الخارجية</h1>
      <p class="hero__lead">
        الملفات البحثية والمهنية على Google Scholar وORCID وIEEE Xplore وGitHub، وصفحات
        المؤلف في الألوكة ومداد، وكتب ومقالات وأخبار أكاديمية منشورة خارج الموقع.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {links.map((link) => (
          <a class="card-link" href={getEntryPath('externalLinks', 'ar', link.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{[link.data.category, link.data.sourceName].filter(Boolean).join(' | ')}</p>
              <h3>{link.data.title}</h3>
              <p>{link.data.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
