---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import '../../../../../styles/global.css';
import { getArticleSeriesPath, getEntryPath } from '../../../../../utils/content-routing';

const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const articleForms: [string, string, string, string, string] = ['مقال واحد', 'مقالان', 'مقالات', 'مقالًا', 'مقال'];
const partForms: [string, string, string, string, string] = ['حلقة واحدة', 'حلقتان', 'حلقات', 'حلقةً', 'حلقة'];

const articles = (await getCollection('articles'))
  .filter((entry) => entry.data.lang === 'ar' && !entry.data.draft && entry.data.sourceName === 'شبكة الألوكة')
  .sort((a, b) => {
    const aTime = a.data.date ? new Date(a.data.date).getTime() : 0;
    const bTime = b.data.date ? new Date(b.data.date).getTime() : 0;

    return bTime - aTime;
  });

const categoryMap = new Map<string, number>();
const seriesMap = new Map<string, { title: string; count: number }>();

for (const article of articles) {
  if (article.data.category) {
    categoryMap.set(article.data.category, (categoryMap.get(article.data.category) ?? 0) + 1);
  }

  if (article.data.series && article.data.seriesSlug) {
    const existing = seriesMap.get(article.data.seriesSlug);
    if (existing) {
      existing.count += 1;
    } else {
      seriesMap.set(article.data.seriesSlug, { title: article.data.series, count: 1 });
    }
  }
}

const topCategories = Array.from(categoryMap.entries()).sort((a, b) => b[1] - a[1]).slice(0, 8);
const topSeries = Array.from(seriesMap.entries())
  .map(([slug, data]) => ({ slug, ...data }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="مقالات الألوكة | د. هيثم الغريب"
  description={`نشر د. هيثم الغريب في شبكة الألوكة ${countAr(articles.length, articleForms)} في الحديث وعلومه والعقيدة والمواعظ والدعوة والتفسير.`}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">مقالات الألوكة</p>
      <h1 class="hero__title">كل مقالات الألوكة</h1>
      <p class="hero__lead">
        نشر د. هيثم الغريب في شبكة الألوكة {countAr(articles.length, articleForms)}، تجدها هنا مرتبة من
        الأحدث إلى الأقدم، مع رابط كل مقال في مصدره الأصلي.
      </p>

      <div class="hero__actions">
        <a class="button" href="/ar/fields/alukah/">الألوكة</a>
        <a class="button-secondary" href="/ar/external-links/alukah-author-page/">صفحة الكاتب في الألوكة</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">التصنيفات</p>
        <h2 class="section-title">أكثر التصنيفات مقالات</h2>
      </div>

      <ul class="entity-tags">
        {topCategories.map(([name, count]) => (
          <li><a href={`/ar/articles/#category-${name.replace(/\s+/g, '-')}`}>{name} ({count})</a></li>
        ))}
      </ul>
    </section>

    {topSeries.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">السلاسل</p>
          <h2 class="section-title">سلاسل منشورة في الألوكة</h2>
        </div>

        <div class="grid-two">
          {topSeries.map((series) => (
            <a class="card-link" href={getArticleSeriesPath('ar', series.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{countAr(series.count, partForms)}</p>
                <h3>{series.title}</h3>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">كل المقالات</p>
        <h2 class="section-title">من الأحدث إلى الأقدم</h2>
      </div>

      <div class="grid-two">
        {articles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'ar', article.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[article.data.category, article.data.date].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
              <p class="content-card__meta">
                {[article.data.series, article.data.readingTime].filter(Boolean).join(' | ')}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
