---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const fieldCards = [
  {
    title: 'الدراسات الإسلامية',
    copy: 'مقالات وشروح في أصول الفقه والحديث والعقيدة والتفسير، وفي مقدمتها ملخصات شروح «الرسالة» للإمام الشافعي.',
    href: '/ar/fields/islamic-studies/',
  },
  {
    title: 'الدفاع عن السنة والشبهات',
    copy: 'سلسلة «الميزان: كيف نزن الشبهات»، وملخص كتاب «لماذا لم أتشيع»، ومقالات في الذب عن «صحيح البخاري».',
    href: '/ar/fields/defense-of-sunnah/',
  },
  {
    title: 'الألوكة',
    copy: 'المقالات والكتب المنشورة في شبكة الألوكة، مرتبة من الأحدث إلى الأقدم مع روابطها الأصلية.',
    href: '/ar/fields/alukah/',
  },
  {
    title: 'المخطوطات',
    copy: 'ملخصات دورات الشيخ صالح الأزهري في علوم المخطوطات، وتحقيق «التوضيح للأوهام الواقعة في الصحيح».',
    href: '/ar/fields/manuscripts/',
  },
  {
    title: 'الذكاء الاصطناعي والتراث الإسلامي',
    copy: 'مقالات في الذكاء الاصطناعي والعلوم الشرعية وتحليل الأسانيد بالخوارزميات، وأدوات مذاكرة رقمية.',
    href: '/ar/fields/ai-and-islamic-heritage/',
  },
  {
    title: 'التحكيم العلمي',
    copy: 'إدارة تحرير مجلة المنصورة لعلوم الحاسبات والمعلومات، وتحكيم البحوث، ولجان مناقشة رسائل الدكتوراه.',
    href: '/ar/fields/academic-reviewing/',
  },
  {
    title: 'التعليم الإلكتروني للعلوم الإسلامية',
    copy: 'كتب في المعمارية الموجهة للخدمات لدعم التعليم الإلكتروني، ومقالات في التعليم الشرعي في العصر الرقمي.',
    href: '/ar/fields/e-learning/',
  },
];
const seoTitle = buildSeoTitle('المجالات العلمية', {
  lang: 'ar',
  section: 'المجالات العلمية',
});
const seoDescription = buildSeoDescription(
  'الدراسات الإسلامية، والدفاع عن السنة، ومقالات الألوكة، وعلوم المخطوطات، والذكاء الاصطناعي والتراث، والتحكيم العلمي، والتعليم الإلكتروني.',
  [],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">المجالات العلمية</p>
      <h1 class="hero__title">المجالات العلمية</h1>
      <p class="hero__lead">
        مقالات الموقع وكتبه وتحقيقاته مجموعة بحسب موضوعها، من أصول الفقه والحديث إلى علوم
        المخطوطات والتحرير العلمي والتعليم الإلكتروني.
      </p>

      <div class="hero__actions">
        <a class="button" href="/ar/articles/">المقالات</a>
        <a class="button-secondary" href="/ar/learning-path/">المسار التعليمي</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-three">
        {fieldCards.map((field) => (
          <a class="card-link" href={field.href}>
            <article class="feature-card feature-card--field">
              <h3>{field.title}</h3>
              <p>{field.copy}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
