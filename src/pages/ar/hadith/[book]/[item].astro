---
// Hadith pages of the first two books (published here before) moved to their book's own site (/hadith-<book>/); this keeps the old addresses working.
import { books, hadithPath, kitabPath } from '../../../../utils/hadith';

export function getStaticPaths() {
  return books.filter((b) => ['bukhari', 'malik'].includes(b.book.id)).flatMap((b) =>
    b.kutub.flatMap((k) => [
      { params: { book: b.book.id, item: k.slug }, props: { to: kitabPath('ar', b.book.id, k.slug) } },
      ...k.hadith.map((h) => ({ params: { book: b.book.id, item: String(h.n) }, props: { to: hadithPath('ar', b.book.id, h.n) } })),
    ]),
  );
}

const { to } = Astro.props as { to: string };
---
<!doctype html><meta charset="utf-8"><meta name="robots" content="noindex"><link rel="canonical" href={new URL(to, 'https://helghareeb.github.io').toString()}><meta http-equiv="refresh" content={`0; url=${to}`}><a href={to}>{to}</a>
