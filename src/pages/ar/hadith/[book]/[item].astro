---
// Main site: the pages of books without their own site yet; for books that have one, a redirect from
// the old address (/ar/hadith/<book>/...) to it.
import HadithPage from '../../../../components/HadithPage.astro';
import { books, HADITH_BOOK, hadithPath, hasBookSite, kitabPath, type Book, type Hadith, type Kitab } from '../../../../utils/hadith';

export function getStaticPaths() {
  if (HADITH_BOOK) return [];
  return books.flatMap((b) =>
    b.kutub.flatMap((k) => [
      { params: { book: b.book.id, item: k.slug }, props: { b, k, h: null, to: hasBookSite(b.book.id) ? kitabPath('ar', b.book.id, k.slug) : null } },
      ...k.hadith.map((h) => ({
        params: { book: b.book.id, item: String(h.n) },
        props: { b, k, h, to: hasBookSite(b.book.id) ? hadithPath('ar', b.book.id, h.n) : null },
      })),
    ]),
  );
}

const { b, k, h, to } = Astro.props as { b: Book; k: Kitab; h: Hadith | null; to: string | null };
---

{to ? (
  <html lang="ar">
    <head>
      <meta charset="utf-8" />
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={new URL(to, 'https://helghareeb.github.io').toString()} />
      <meta http-equiv="refresh" content={`0; url=${to}`} />
    </head>
    <body><a href={to}>{to}</a></body>
  </html>
) : (
  <HadithPage lang="ar" b={b} k={k} h={h} />
)}
