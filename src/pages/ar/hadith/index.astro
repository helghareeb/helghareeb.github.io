---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';
import { books, hadithLabels, kitabPath, num } from '../../../utils/hadith';

const t = hadithLabels.ar;
const seoTitle = buildSeoTitle('الحديث النبوي', { lang: 'ar', section: 'د. هيثم الغريب' });
const seoDescription = buildSeoDescription('أحاديث الكتب التسعة بصوت القارئ الدكتور يوسف بن نوح أحمد: النص المشكول بإسناده، وغريب الحديث، والحكم والتخريج، والترجمة الإنجليزية؛ ويُضاف إليها شرح موجز وفوائد بإذن الله. نبدأ بكتاب بدء الوحي من صحيح البخاري.', books.map((b) => b.book.ar));
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">{t.section}</p>
      <h1 class="hero__title">الحديث النبوي</h1>
      <p class="hero__lead">أحاديث الكتب التسعة بصوت القارئ الدكتور يوسف بن نوح أحمد: النص المشكول بإسناده، وغريب الحديث، والحكم والتخريج، والترجمة الإنجليزية؛ ويُضاف إليها شرح موجز وفوائد بإذن الله. نبدأ بكتاب بدء الوحي من صحيح البخاري.</p>
    </section>
    <section class="shell section hadith-about">
      <h2>عن المشروع</h2>
      <p>
        مشروع دعوي علمي مستمر يهدف إلى أن يكون لكل حديث من الكتب التسعة صفحةٌ تُسمع وتُقرأ وتُفهم وتُشارك:
        يسمع القارئ الحديث بإسناده، ويقرأ نصه مشكولًا، ويفهم غريبه، ويعرف حكمه ومصدره، ثم ينتفع بشرح موجز وفوائد.
      </p>
      <div class="grid-two">
        <article class="content-card">
          <h3>في صفحة كل حديث</h3>
          <ul>
            <li>الصوت بقراءة الدكتور يوسف بن نوح أحمد، مقسَّمًا حديثًا حديثًا ومراجَعًا بالسماع.</li>
            <li>النص المشكول، والإسناد منفصلًا عن المتن.</li>
            <li>غريب الحديث مُعلَّمًا في النص، يُضغط عليه فيظهر معناه ومصدره.</li>
            <li>الحكم والتخريج والترجمة الإنجليزية.</li>
            <li>شرح موجز وفوائد، تُراجع وتزاد تباعًا.</li>
          </ul>
        </article>
        <article class="content-card">
          <h3>المصادر</h3>
          <ul>
            <li>القراءة: الدكتور يوسف بن نوح أحمد، وقد أذن باستعمالها في هذا المشروع جزاه الله خيرًا.</li>
            <li>النصوص: طبعات الكتب التسعة المعتمدة وترقيمها المشهور.</li>
            <li>الغريب: النهاية لابن الأثير ولسان العرب وغيرهما من كتب الغريب واللغة.</li>
            <li>الترجمة الإنجليزية: sunnah.com.</li>
          </ul>
        </article>
      </div>
      <h3>الكتب التسعة</h3>
      <div class="table-wrap">
        <table class="hadith-plan">
          <thead><tr><th>الكتاب</th><th>الحالة</th></tr></thead>
          <tbody>
            <tr><td>صحيح البخاري</td><td>بدأ: كتاب بدء الوحي</td></tr>
            <tr><td>صحيح مسلم</td><td>الصوت جاهز للتقسيم</td></tr>
            <tr><td>سنن أبي داود</td><td>الصوت جاهز للتقسيم</td></tr>
            <tr><td>جامع الترمذي</td><td>الصوت جاهز للتقسيم</td></tr>
            <tr><td>سنن النسائي، سنن ابن ماجه، موطأ مالك، مسند أحمد</td><td>قيد الإعداد</td></tr>
            <tr><td>سنن الدارمي</td><td>يُبحث عن تسجيل</td></tr>
          </tbody>
        </table>
      </div>
      <p class="content-card__meta">
        رأيت خطأً في نص أو صوت أو شرح؟ في كل حديث زر «الإبلاغ عن خطأ»، والمراجعة مستمرة بإذن الله.
      </p>
    </section>
    {books.map((b) => (
      <section class="shell section">
        <h2>{b.book.ar}</h2>
        <div class="grid-two">
          {b.kutub.map((k) => (
            <a class="card-link" href={kitabPath('ar', b.book.id, k.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{t.count(k.hadith.length)} · {num('ar', k.first)}–{num('ar', k.last)}</p>
                <h3>{k.ar}</h3>
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
