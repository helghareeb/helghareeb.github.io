---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getArticleSeriesPath, getEntryPath } from '../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../utils/seo';

const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const partForms: [string, string, string, string, string] = ['حلقة واحدة', 'حلقتان', 'حلقات', 'حلقةً', 'حلقة'];

const byDateDesc = (a: { data: { date?: string } }, b: { data: { date?: string } }) => {
  const aTime = a.data.date ? new Date(a.data.date).getTime() : 0;
  const bTime = b.data.date ? new Date(b.data.date).getTime() : 0;

  return bTime - aTime;
};

const allBooks = (await getCollection('books'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => {
    const yearCompare = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearCompare !== 0) return yearCompare;

    return a.data.title.localeCompare(b.data.title, 'ar');
  });
const qatra = allBooks.find((entry) => entry.slug === 'qatra-min-al-hayah-ar');
const featuredBooks = [
  ...(qatra ? [qatra] : []),
  ...allBooks.filter((entry) => entry !== qatra && entry.data.workType !== 'شرائح عرض'),
].slice(0, 4);

const featuredEditions = (await getCollection('editions'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0))
  .slice(0, 2);

const allArticles = (await getCollection('articles'))
  .filter((entry) => entry.data.lang === 'ar' && !entry.data.draft)
  .sort(byDateDesc);
const featuredArticles = allArticles.slice(0, 6);

const articleSeriesMap = new Map<string, { title: string; slug: string; count: number }>();

for (const article of allArticles) {
  if (!article.data.series || !article.data.seriesSlug) continue;

  const existing = articleSeriesMap.get(article.data.seriesSlug);

  if (existing) {
    existing.count += 1;
  } else {
    articleSeriesMap.set(article.data.seriesSlug, {
      title: article.data.series,
      slug: article.data.seriesSlug,
      count: 1,
    });
  }
}

const featuredSeries = Array.from(articleSeriesMap.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);

const featuredProjects = (await getCollection('projects')).filter((entry) => entry.data.lang === 'ar');

const featuredFields = [
  {
    title: 'الدراسات الإسلامية',
    copy: 'أصول الفقه والحديث والعقيدة والتفسير، وفي مقدمتها ملخصات شروح «الرسالة» للإمام الشافعي.',
    href: '/ar/fields/islamic-studies/',
  },
  {
    title: 'علوم المخطوطات',
    copy: 'ملخصات دورات الشيخ صالح الأزهري في علوم المخطوطات، وتحقيق النصوص التراثية.',
    href: '/ar/fields/manuscripts/',
  },
  {
    title: 'مذاكرة طالب العلم',
    copy: 'دفاتر فوائد من شروح أهل العلم، وبطاقات للمراجعة والتدريب والاختبار.',
    href: '/ar/study/',
  },
];

const seoTitle = buildSeoTitle('د. هيثم عبدالمنعم الغريب', {
  lang: 'ar',
  section: 'الموقع الشخصي العلمي',
});
const seoDescription = buildSeoDescription(
  'أستاذ نظم المعلومات المساعد بجامعة المنصورة ومدير تحرير مجلة المنصورة لعلوم الحاسبات والمعلومات: كتب وتحقيقات ومقالات في أصول الفقه والحديث وعلوم المخطوطات، وأدوات مذاكرة لطالب العلم.',
  [],
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main page-main--home">
    <section class="shell hero hero--home">
      <p class="hero__eyebrow">أستاذ نظم المعلومات المساعد – جامعة المنصورة</p>
      <h1 class="hero__title">د. هيثم عبدالمنعم الغريب</h1>
      <p class="hero__lead">
        أستاذ نظم المعلومات المساعد بكلية الحاسبات والمعلومات بجامعة المنصورة، ومدير تحرير
        مجلة المنصورة لعلوم الحاسبات والمعلومات، يجمع بين البحث في نظم المعلومات وطلب العلم
        الشرعي وخدمته تأليفًا وتلخيصًا وتحقيقًا.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">نظم المعلومات</span>
        <span class="hero__badge">أصول الفقه</span>
        <span class="hero__badge">علوم المخطوطات والتحقيق</span>
        <span class="hero__badge">التعليم الإلكتروني</span>
      </div>

      <div class="hero__actions">
        <a class="button" href="/ar/cv/">السيرة الذاتية</a>
        <a class="button-secondary" href="/ar/hadith/">الحديث النبوي</a>
        <a class="button-secondary" href="/ar/books/">الكتب</a>
        <a class="button-secondary" href="/ar/editions/">التحقيقات</a>
        <a class="button-secondary" href="/ar/articles/">المقالات</a>
      </div>

      <div class="grid-three hero__stats">
        <a class="card-link" href="/ar/articles/">
          <article class="stat-card">
            <strong>{allArticles.length}</strong>
            <span>مقالًا وملخصًا في العلوم الشرعية والفكر والدعوة</span>
          </article>
        </a>
        <a class="card-link" href="/ar/books/">
          <article class="stat-card">
            <strong>{allBooks.length}</strong>
            <span>كتابًا وعملًا منشورًا، ورقيًا وإلكترونيًا</span>
          </article>
        </a>
        <a class="card-link" href="/ar/articles/series/">
          <article class="stat-card">
            <strong>{articleSeriesMap.size}</strong>
            <span>سلسلة مقالات تُقرأ حلقاتها متتابعة</span>
          </article>
        </a>
      </div>
    </section>

    <section class="shell section">
      <a class="card-link" href="/ar/hadith/">
        <article class="content-card hadith-feature">
          <p class="section-kicker">مشروع مستمر</p>
          <h2 class="section-title">الحديث النبوي: الكتب التسعة</h2>
          <p>
            لكل حديث من الكتب التسعة صفحة: صوته بقراءة الدكتور يوسف بن نوح أحمد، ونصه المشكول بإسناده،
            وغريبه مشروحًا، وحكمه وتخريجه، وشرح موجز وفوائد، وترجمته الإنجليزية؛ ومرئيات للأحاديث المختارة.
          </p>
          <span class="button">ابدأ بكتاب بدء الوحي من صحيح البخاري</span>
        </article>
      </a>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">المجالات</p>
        <h2 class="section-title">من مجالات الموقع</h2>
      </div>

      <div class="grid-three">
        {featuredFields.map((field) => (
          <a class="card-link" href={field.href}>
            <article class="feature-card feature-card--field">
              <h3>{field.title}</h3>
              <p>{field.copy}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/ar/fields/">كل المجالات العلمية</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">الكتب</p>
        <h2 class="section-title">من أحدث الكتب</h2>
      </div>

      <div class="grid-two">
        {featuredBooks.map((book) => (
          <a class="card-link" href={getEntryPath('books', 'ar', book.slug)}>
            <article class="content-card">
              <p class="content-card__meta">{[book.data.workType, book.data.year].filter(Boolean).join(' | ')}</p>
              <h3>{book.data.title}</h3>
              <p>{book.data.summary}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/ar/books/">كل الكتب</a>
      </div>
    </section>

    {featuredEditions.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">التحقيقات</p>
          <h2 class="section-title">تحقيق التراث</h2>
        </div>

        <div class="grid-two">
          {featuredEditions.map((edition) => (
            <a class="card-link" href={getEntryPath('editions', 'ar', edition.slug)}>
              <article class="content-card">
                <p class="content-card__meta">{[edition.data.workType, edition.data.year].filter(Boolean).join(' | ')}</p>
                <h3>{edition.data.title}</h3>
                <p>{edition.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">المقالات</p>
        <h2 class="section-title">أحدث المقالات</h2>
      </div>

      <div class="grid-three">
        {featuredArticles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'ar', article.slug)}>
            <article class="content-card">
              <p class="content-card__meta">
                {[article.data.category, article.data.date].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/ar/articles/">كل المقالات</a>
      </div>
    </section>

    {featuredSeries.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">السلاسل</p>
          <h2 class="section-title">سلاسل المقالات</h2>
        </div>

        <div class="grid-two">
          {featuredSeries.map((series) => (
            <a class="card-link" href={getArticleSeriesPath('ar', series.slug)}>
              <article class="content-card">
                <p class="content-card__meta">{countAr(series.count, partForms)}</p>
                <h3>{series.title}</h3>
              </article>
            </a>
          ))}
        </div>

        <div class="hero__actions">
          <a class="button-secondary" href="/ar/articles/series/">كل السلاسل</a>
        </div>
      </section>
    )}

    {featuredProjects.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">المشروعات</p>
          <h2 class="section-title">مشروعات مفتوحة المصدر</h2>
        </div>

        <div class="grid-two">
          {featuredProjects.map((project) => (
            <a class="card-link" href={getEntryPath('projects', 'ar', project.slug)}>
              <article class="content-card">
                <p class="content-card__meta">{[project.data.area, project.data.startYear].filter(Boolean).join(' | ')}</p>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="shell cta-panel">
      <div>
        <p class="section-kicker">لطالب العلم</p>
        <h2 class="section-title">مسار متدرج من المتون إلى المخطوطات</h2>
        <p class="section-copy">
          من «أخصر المختصرات» في الفقه، إلى «الرسالة» للإمام الشافعي، فتفسير الطبري، ثم علوم
          المخطوطات، مع ملخصات وفوائد وبطاقات مذاكرة لكل مرحلة.
        </p>
      </div>
      <div class="hero__actions">
        <a class="button" href="/ar/learning-path/">المسار التعليمي</a>
        <a class="button-secondary" href="/ar/study/">مذاكرة طالب العلم</a>
      </div>
    </section>
  </main>
</BaseLayout>
