---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.lang === 'ar')
  .sort((a, b) => Number(b.data.startYear ?? 0) - Number(a.data.startYear ?? 0));
const seoTitle = buildSeoTitle('المشروعات', {
  lang: 'ar',
  section: 'المشروعات',
});
const seoDescription = buildSeoDescription(
  'مشروعات رقمية وتعليمية مفتوحة المصدر على GitHub، منها هذا الموقع ومواد مقرر التصور المعلوماتي.',
  projects.map((project) => project.data.title),
);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">المشروعات</p>
      <h1 class="hero__title">المشروعات الرقمية والتعليمية</h1>
      <p class="hero__lead">
        مشروعات مفتوحة المصدر منشورة على GitHub، تجمع بين النشر العلمي الرقمي ومواد
        المقررات الجامعية.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {projects.map((project) => (
          <a class="card-link" href={getEntryPath('projects', 'ar', project.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{[project.data.area, project.data.startYear].filter(Boolean).join(' | ')}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
              {project.data.status && <p class="content-card__meta">{project.data.status}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
