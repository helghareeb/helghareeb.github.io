---
import PublicationList from '../../../components/PublicationList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { publications, scholarMetrics } from '../../../data/publications';

const groups = [
  { type: 'journal', title: 'أبحاث منشورة في دوريات' },
  { type: 'conference', title: 'أبحاث مؤتمرات' },
  { type: 'chapter', title: 'فصول في كتب' },
  { type: 'book', title: 'كتب' },
] as const;
const highlighted = publications.filter((pub) => pub.highlight);
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="الأبحاث المنشورة | د. هيثم عبدالمنعم الغريب"
  description="الأبحاث المحكّمة وأبحاث المؤتمرات والفصول والكتب للدكتور هيثم عبدالمنعم الغريب، مع روابط DOI."
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">البحث العلمي</p>
      <h1 class="hero__title">الأبحاث المنشورة</h1>
      <p class="hero__lead">
        {publications.length} عملًا في نظم المعلومات، واتخاذ القرار بالمنطق النيوتروسوفي، والتعليم
        الإلكتروني، والمعماريات الخدمية والسحابية، ومعالجة البيانات على الحافة. العناوين التي لها
        معرّف DOI ترتبط بالنسخة المنشورة.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-three">
        <article class="stat-card">
          <strong>{scholarMetrics.citations}</strong>
          <span>استشهادًا</span>
        </article>
        <article class="stat-card">
          <strong>{scholarMetrics.hIndex}</strong>
          <span>مؤشر h</span>
        </article>
        <article class="stat-card">
          <strong>{scholarMetrics.i10Index}</strong>
          <span>مؤشر i10</span>
        </article>
      </div>
      <p class="content-card__meta">
        المصدر: Google Scholar، يونيو 2026م. الأرقام المحدثة:
        <a href="https://scholar.google.com/citations?user=f66uaewAAAAJ&hl=en">Google Scholar</a> ·
        <a href="https://orcid.org/0000-0003-1875-6706">ORCID</a> ·
        <a href="https://scholargps.com/scholars/54142940845340/haitham-a-el-ghareeb">ScholarGPS</a> ·
        <a href="https://ieeexplore.ieee.org/author/37086352024">IEEE Xplore</a>
      </p>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">الأحدث</p>
        <h2 class="section-title">من أحدث الأبحاث المنشورة في دوريات</h2>
      </div>
      <PublicationList items={highlighted} />
    </section>

    {groups.map((group) => {
      const items = publications.filter((pub) => pub.type === group.type && !pub.highlight);
      return (
        <section class="shell section">
          <div class="section-heading">
            <h2 class="section-title">{group.title}</h2>
          </div>
          <PublicationList items={items} />
        </section>
      );
    })}
  </main>
</BaseLayout>
