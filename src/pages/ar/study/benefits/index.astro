---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { getEntryPath } from '../../../../utils/content-routing';
import { getStudyBenefitBookPath, groupStudyBenefits, getStudyBenefitRouteSlug } from '../../../../utils/study';

const publishedBenefits = (await getCollection('studyBenefits')).filter(
  (entry) => entry.data.lang === 'ar' && !entry.data.draft,
);
const groupedBenefits = groupStudyBenefits(publishedBenefits);

const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const notebookForms: [string, string, string, string, string] = ['دفتر واحد', 'دفتران', 'دفاتر', 'دفترًا', 'دفتر'];
const seoTitle = buildSeoTitle('فوائد من كتب متنوعة', {
  lang: 'ar',
  section: 'مذاكرة طالب العلم',
});
const seoDescription = buildSeoDescription(
  'دفاتر فوائد علمية مستخلصة من شروح الرسالة للإمام الشافعي وتفسير الطبري، مرتبة بالفن ثم بالكتاب.',
  [countAr(publishedBenefits.length, notebookForms)],
);
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">فوائد من كتب متنوعة</p>
      <h1 class="hero__title">فوائد علمية مرتبة بالفن والكتاب</h1>
      <p class="hero__lead">
        فوائد مختارة من شروح «الرسالة» للإمام الشافعي ودروس تفسير الطبري، في
        {countAr(publishedBenefits.length, notebookForms)} موزعة على أصول الفقه والفقه والعقيدة
        والتفسير واللغة والتزكية، مع ذكر الشارح في كل دفتر.
      </p>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">الدفاتر المنشورة</p>
        <h2 class="section-title">الفوائد مرتبة بالفن ثم بالكتاب</h2>
      </div>

      <div class="grid-two">
        {groupedBenefits.map((group) => (
          <article class="content-card entity-card">
            <p class="content-card__meta">{group.field}</p>
            <h3>
              <a href={getStudyBenefitBookPath('ar', group.fieldSlug, group.bookSlug)}>{group.bookTitle}</a>
            </h3>
            {group.teacher && <p>{group.teacher}</p>}
            <p class="content-card__meta">{countAr(group.entries.length, notebookForms)}</p>
            <ul class="entity-list">
              {group.entries.map((entry) => (
                <li>
                  <a href={getEntryPath('studyBenefits', 'ar', getStudyBenefitRouteSlug(entry.slug))}>{entry.data.title}</a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
