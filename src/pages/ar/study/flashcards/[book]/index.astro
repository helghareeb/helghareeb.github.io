---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import '../../../../../styles/global.css';
import { getFlashcardModePath } from '../../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../../utils/seo';

export async function getStaticPaths() {
  const decks = await getCollection('flashcardDecks');

  return decks
    .filter((entry) => entry.data.lang === 'ar' && !entry.data.draft)
    .map((entry) => ({
      params: { book: entry.slug.replace(/-(ar|en)$/, '') },
      props: { deck: entry },
    }));
}

const { deck } = Astro.props as { deck: CollectionEntry<'flashcardDecks'> };
const cards = (await getCollection('flashcards')).filter(
  (entry) => entry.data.lang === 'ar' && !entry.data.draft && entry.data.deckSlug === deck.slug.replace(/-(ar|en)$/, ''),
);
const counts = {
  review: cards.filter((card) => card.data.mode === 'review').length,
  training: cards.filter((card) => card.data.mode === 'training').length,
  test: cards.filter((card) => card.data.mode === 'test').length,
};
const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};
const questionForms: [string, string, string, string, string] = ['سؤال واحد', 'سؤالان', 'أسئلة', 'سؤالًا', 'سؤال'];
const seoTitle = buildSeoTitle(deck.data.title, {
  lang: 'ar',
  section: 'بطاقات المذاكرة',
});
const seoDescription = buildSeoDescription(deck.data.summary, [
  deck.data.field,
  deck.data.bookTitle,
  countAr(cards.length, questionForms),
]);
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">بطاقات المذاكرة</p>
      <h1 class="hero__title">{deck.data.bookTitle}</h1>
      <p class="hero__lead">{deck.data.summary}</p>

      <div class="hero__badge-row">
        <span class="hero__badge">{deck.data.field}</span>
        <span class="hero__badge">{countAr(cards.length, questionForms)}</span>
        {deck.data.status && <span class="hero__badge">{deck.data.status}</span>}
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        <a class="card-link" href={getFlashcardModePath('ar', deck.slug, 'review')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">الخطوة ١ · {countAr(counts.review, ['بطاقة واحدة', 'بطاقتان', 'بطاقات', 'بطاقةً', 'بطاقة'])}</p>
            <h3>المراجعة</h3>
            <p>اقرأ السؤال مع جوابه لتثبيت المادة قبل أن تختبر نفسك.</p>
          </article>
        </a>
        <a class="card-link" href={getFlashcardModePath('ar', deck.slug, 'training')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">الخطوة ٢ · {countAr(counts.training, questionForms)}</p>
            <h3>التدريب</h3>
            <p>يظهر السؤال وحده، فتحاول الإجابة ثم تكشف الجواب وتقيّم نفسك.</p>
          </article>
        </a>
        <a class="card-link" href={getFlashcardModePath('ar', deck.slug, 'test')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">الخطوة ٣ · {countAr(counts.test, questionForms)}</p>
            <h3>الاختبار</h3>
            <p>أسئلة بلا أجوبة ظاهرة تقيس مقدار تمكنك من المادة.</p>
          </article>
        </a>
        <a class="card-link" href={getFlashcardModePath('ar', deck.slug, 'results')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">الخطوة ٤</p>
            <h3>النتائج</h3>
            <p>ملخص إجاباتك المحفوظة على هذا الجهاز، مع الأسئلة التي أخطأت فيها لتعيد مراجعتها.</p>
          </article>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
