---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';
import { getStudyBenefitBookPath, groupStudyBenefits } from '../../../utils/study';

const countAr = (n: number, [one, two, few, many, single]: [string, string, string, string, string]) => {
  if (n === 1) return one;
  if (n === 2) return two;
  const r = n % 100;
  if (r >= 3 && r <= 10) return `${n} ${few}`;
  if (r >= 11) return `${n} ${many}`;
  return `${n} ${single}`;
};

const benefits = (await getCollection('studyBenefits')).filter((entry) => entry.data.lang === 'ar' && !entry.data.draft);
const benefitGroups = groupStudyBenefits(benefits);
const decks = (await getCollection('flashcardDecks')).filter((entry) => entry.data.lang === 'ar' && !entry.data.draft);
const cards = (await getCollection('flashcards')).filter((entry) => entry.data.lang === 'ar' && !entry.data.draft);

const sourceMap = new Map<string, { title: string; teacher?: string; fields: { name: string; href: string }[] }>();
for (const group of benefitGroups) {
  const field = { name: group.field, href: getStudyBenefitBookPath('ar', group.fieldSlug, group.bookSlug) };
  const existing = sourceMap.get(group.bookSlug);
  if (existing) {
    existing.fields.push(field);
    continue;
  }
  sourceMap.set(group.bookSlug, { title: group.bookTitle, teacher: group.teacher, fields: [field] });
}
const sources = Array.from(sourceMap.values());

const notebookForms: [string, string, string, string, string] = ['دفتر واحد', 'دفتران', 'دفاتر', 'دفترًا', 'دفتر'];
const questionForms: [string, string, string, string, string] = ['سؤال واحد', 'سؤالان', 'أسئلة', 'سؤالًا', 'سؤال'];

const tracks = [
  {
    eyebrow: countAr(benefits.length, notebookForms),
    title: 'فوائد من كتب متنوعة',
    href: '/ar/study/benefits/',
    summary: 'فوائد مختارة من شروح «الرسالة» للإمام الشافعي ودروس تفسير الطبري، مرتبة بالفن ثم بالكتاب مع ذكر الشارح.',
  },
  {
    eyebrow: countAr(cards.length, questionForms),
    title: 'بطاقات المذاكرة',
    href: '/ar/study/flashcards/',
    summary: `أسئلة للمراجعة والتدريب والاختبار على ${decks.map((deck) => `«${deck.data.bookTitle}»`).join('، ')}، مع حفظ نتائجك والعودة إلى ما أخطأت فيه.`,
  },
];

const seoTitle = buildSeoTitle('مذاكرة طالب العلم', {
  lang: 'ar',
  section: 'الدراسة والمراجعة',
});
const seoDescription = buildSeoDescription(
  'فوائد منظمة من شروح الرسالة للشافعي وتفسير الطبري، وبطاقات مذاكرة للمراجعة والتدريب والاختبار على أخصر المختصرات.',
  [countAr(benefits.length, notebookForms), countAr(cards.length, questionForms)],
);
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">مذاكرة طالب العلم</p>
      <h1 class="hero__title">فوائد وبطاقات لمراجعة ما تدرسه</h1>
      <p class="hero__lead">
        دفاتر فوائد مستخلصة من دروس أهل العلم، وبطاقات أسئلة تعين على التكرار والمراجعة
        والتدريب والاختبار.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {tracks.map((track) => (
          <a class="card-link" href={track.href}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{track.eyebrow}</p>
              <h3>{track.title}</h3>
              <p>{track.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">المصادر</p>
        <h2 class="section-title">الكتب والشروح التي استُخلصت منها المادة</h2>
      </div>

      <div class="grid-two">
        {sources.map((source) => (
          <article class="content-card entity-card">
            <p class="content-card__meta">دفاتر الفوائد</p>
            <h3>{source.title}</h3>
            {source.teacher && <p>{source.teacher}</p>}
            <ul class="entity-tags">
              {source.fields.map((field) => (
                <li><a href={field.href}>{field.name}</a></li>
              ))}
            </ul>
          </article>
        ))}
        {decks.map((deck) => (
          <a class="card-link" href={getEntryPath('flashcardDecks', 'ar', deck.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">بطاقات المذاكرة · {deck.data.field}</p>
              <h3>{deck.data.bookTitle}</h3>
              {deck.data.status && <p>{deck.data.status}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
