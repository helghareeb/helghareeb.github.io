---
import VideoPlaylist from '../../../components/VideoPlaylist.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';
import { getFolderUrl, getPlaylistPath, getWhatsAppUrl, playlists, videoLabels, type Playlist } from '../../../utils/videos';
import { siteConfig } from '../../../../config/site';

export function getStaticPaths() {
  return playlists.map((playlist) => ({ params: { playlist: playlist.slug }, props: { playlist } }));
}

const { playlist } = Astro.props as { playlist: Playlist };
const t = videoLabels.ar;
const pageUrl = new URL(getPlaylistPath('ar', playlist.slug), siteConfig.siteUrl).toString();
const seoTitle = buildSeoTitle(playlist.title.ar, { lang: 'ar', section: 'المرئيات' });
const seoDescription = buildSeoDescription(playlist.summary.ar, playlist.videos.map((video) => video.titleAr));
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">{playlist.course.ar} · {playlist.year} · {t.videos(playlist.videos.length)}</p>
      <h1 class="hero__title">{playlist.title.ar}</h1>
      <p class="hero__lead">{playlist.summary.ar}</p>
      <div class="hero__actions">
        <a class="button-secondary" href={playlist.repoUrl}>{t.repo}</a>
        <a class="button-secondary" href={getFolderUrl(playlist)}>{t.folder}</a>
        <a class="button-secondary" href={getWhatsAppUrl(playlist.title.ar, pageUrl)}>{t.share}</a>
      </div>
    </section>

    <section class="shell section">
      <VideoPlaylist lang="ar" playlist={playlist} />
    </section>
  </main>
</BaseLayout>
