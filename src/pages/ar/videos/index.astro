---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';
import { getPlaylistPath, getThumbnailUrl, playlists, videoLabels } from '../../../utils/videos';

const t = videoLabels.ar;
const seoTitle = buildSeoTitle('المرئيات', { lang: 'ar', section: 'د. هيثم الغريب' });
const seoDescription = buildSeoDescription(
  'مرئيات دعوية (سلسلة «لو قالوا» وتلاوات وملخصات كتب) ومحاضرات مسجلة للدكتور هيثم الغريب، للمشاهدة أو التحميل.',
  playlists.map((playlist) => playlist.title.ar),
);
---

<BaseLayout lang="ar" dir="rtl" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">المرئيات</p>
      <h1 class="hero__title">المرئيات</h1>
      <p class="hero__lead">
        مرئيات دعوية: سلسلة «لو قالوا» في الجواب عن الشبهات من القرآن الكريم، وتلاوات، وملخصات كتب؛
        ثم تسجيلات المقررات الجامعية. كل مرئي يُشاهَد هنا مباشرة أو يُحمَّل وينشر.
      </p>
      <div class="hero__actions">
        <a class="button-secondary" href="#dawah">{t.dawahSection}</a>
        <a class="button-secondary" href="#courses">{t.courseSection}</a>
      </div>
    </section>

    <section class="shell section" id="dawah">
      <h2>{t.dawahSection}</h2>
      <div class="grid-two">
        {playlists.filter((playlist) => playlist.kind === 'dawah').map((playlist) => (
          <a class="card-link" href={getPlaylistPath('ar', playlist.slug)}>
            <article class="content-card entity-card">
              {playlist.videos[0] && (
                <img class="video-playlist-cover" src={getThumbnailUrl(playlist.videos[0])} alt="" loading="lazy" referrerpolicy="no-referrer" />
              )}
              <p class="content-card__meta">{playlist.year} · {t.dawahVideos(playlist.videos.length)}</p>
              <h3>{playlist.title.ar}</h3>
              <p>{playlist.summary.ar}</p>
            </article>
          </a>
        ))}
      </div>
    </section>

    <section class="shell section" id="courses">
      <h2>{t.courseSection}</h2>
      <p class="hero__actions">
        <a class="button-secondary" href="/ar/teaching/">التدريس</a>
        <a class="button-secondary" href="/ar/quizzes/">الاختبارات القصيرة</a>
      </p>
      <div class="grid-two">
        {playlists.filter((playlist) => playlist.kind === 'course').map((playlist) => (
          <a class="card-link" href={getPlaylistPath('ar', playlist.slug)}>
            <article class="content-card entity-card">
              {playlist.videos[0] && (
                <img class="video-playlist-cover" src={getThumbnailUrl(playlist.videos[0])} alt="" loading="lazy" referrerpolicy="no-referrer" />
              )}
              <p class="content-card__meta">{playlist.year} · {t.videos(playlist.videos.length)}</p>
              <h3>{playlist.title.ar}</h3>
              <p>{playlist.summary.ar}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
