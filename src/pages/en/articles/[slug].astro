---
import { getCollection, render } from 'astro:content';
import EntityEntryPage from '../../../components/EntityEntryPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryRouteSlug } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter((entry) => entry.data.lang === 'en' && !entry.data.draft);

  return entries.map((entry) => ({
    params: { slug: getEntryRouteSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seoTitle = buildSeoTitle(entry.data.title, { lang: 'en', section: 'Articles' });
const seoDescription = buildSeoDescription(entry.data.summary, [
  entry.data.category,
  entry.data.sourceName,
  entry.data.series,
]);
const isSummary = /^summary/i.test(entry.data.articleType ?? '');
const sourceNotice = `This is an English ${isSummary ? 'summary' : 'version'} of an article first published in Arabic on ${entry.data.sourceName}.`;
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <EntityEntryPage
    lang="en"
    eyebrow="Article"
    title={entry.data.title}
    summary={entry.data.summary}
    badges={[entry.data.category, entry.data.date].filter((value): value is string => Boolean(value))}
    metaItems={[
      ...(entry.data.date ? [{ label: 'Date', value: entry.data.date }] : []),
      ...(entry.data.category ? [{ label: 'Category', value: entry.data.category }] : []),
      ...(entry.data.series ? [{ label: 'Series', value: entry.data.series }] : []),
      ...(entry.data.sourceName ? [{ label: 'Source', value: entry.data.sourceName }] : []),
      ...(entry.data.readingTime ? [{ label: 'Reading time', value: entry.data.readingTime }] : []),
    ]}
    backHref="/en/articles/"
    backLabel="Back to articles"
    externalUrl={entry.data.externalUrl}
    externalLabel={entry.data.sourceName ? `Original on ${entry.data.sourceName}` : 'Original article'}
  >
    <Content />

    {entry.data.seriesSlug && (
      <p>
        <a href={`/en/articles/series/${entry.data.seriesSlug}/`}>All parts of {entry.data.series}</a>
      </p>
    )}

    {entry.data.sourceName && entry.data.externalUrl && (
      <section class="notice-card">
        <p class="entity-kicker">Original publication</p>
        <h2 class="section-title">Originally published on {entry.data.sourceName}</h2>
        <p>
          {sourceNotice}
        </p>
        <p>
          <a href={entry.data.externalUrl}>Read the original article on {entry.data.sourceName}</a>
        </p>
        {entry.data.alternateLinks.length > 0 && (
          <p>
            Also published on:{' '}
            {entry.data.alternateLinks.map((link, index) => (
              <>
                {index > 0 && ' · '}
                <a href={link.url}>{link.name}</a>
              </>
            ))}
          </p>
        )}
      </section>
    )}
  </EntityEntryPage>
</BaseLayout>
