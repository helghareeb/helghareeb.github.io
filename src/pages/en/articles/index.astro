---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getArticleSeriesPath, getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const toTime = (value?: string) => (value ? new Date(value).getTime() : 0);

const allArticles = (await getCollection('articles'))
  .filter((entry) => entry.data.lang === 'en' && !entry.data.draft)
  .sort((a, b) => toTime(b.data.date) - toTime(a.data.date));

const latestArticles = allArticles.slice(0, 12);

const seriesMap = new Map<string, { title: string; slug: string; count: number }>();

for (const article of allArticles) {
  if (!article.data.series || !article.data.seriesSlug) continue;

  const existing = seriesMap.get(article.data.seriesSlug);

  if (existing) {
    existing.count += 1;
  } else {
    seriesMap.set(article.data.seriesSlug, {
      title: article.data.series,
      slug: article.data.seriesSlug,
      count: 1,
    });
  }
}

const seriesList = Array.from(seriesMap.values()).sort((a, b) => b.count - a.count);

const categoryMap = new Map<string, typeof allArticles>();

for (const article of allArticles) {
  const category = article.data.category ?? 'Other';
  categoryMap.set(category, [...(categoryMap.get(category) ?? []), article]);
}

const categories = Array.from(categoryMap.entries()).sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'en'),
);

const seoTitle = buildSeoTitle('Articles', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'English versions of articles by Dr. Haitham A. El-Ghareeb on hadith, creed, Qur\'anic exegesis, legal theory and counsel, first published in Arabic on the Alukah Network.',
  [
    `${allArticles.length} articles`,
    `${seriesList.length} series`,
    allArticles[0]?.data.date ? `Latest ${allArticles[0].data.date}` : undefined,
  ],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Articles</p>
      <h1 class="hero__title">Articles</h1>
      <p class="hero__lead">
        English versions of articles on hadith and its sciences, creed, Qur'anic exegesis, legal theory,
        counsel and da'wah, most of them first published in Arabic on the Alukah Network.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">{allArticles.length} articles</span>
        <span class="hero__badge">{seriesList.length} series</span>
        <span class="hero__badge">{categories.length} categories</span>
      </div>

      <div class="hero__actions">
        <a class="button" href="/en/articles/series/">Article series</a>
        <a class="button-secondary" href="/en/scholarly-fields/alukah/articles/">Alukah articles</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Latest</p>
        <h2 class="section-title">Latest articles</h2>
      </div>

      <div class="grid-two">
        {latestArticles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'en', article.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[article.data.category, article.data.date].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
              <p class="content-card__meta">
                {[article.data.series, article.data.readingTime].filter(Boolean).join(' | ')}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>

    {seriesList.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">Series</p>
          <h2 class="section-title">Article series</h2>
        </div>

        <div class="grid-two">
          {seriesList.map((series) => (
            <a class="card-link" href={getArticleSeriesPath('en', series.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{series.count} parts</p>
                <h3>{series.title}</h3>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">All articles</p>
        <h2 class="section-title">Articles by category</h2>
      </div>

      <div class="grid-two">
        {categories.map(([category, entries]) => (
          <details class="content-card">
            <summary><strong>{category}</strong> ({entries.length})</summary>
            <ul class="list-clean">
              {entries.map((article) => (
                <li>
                  <a href={getEntryPath('articles', 'en', article.slug)}>{article.data.title}</a>
                  {article.data.date && <span class="content-card__meta"> · {article.data.date}</span>}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
