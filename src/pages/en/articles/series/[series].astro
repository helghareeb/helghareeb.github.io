---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getEntryPath } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { seriesIntroLead, seriesIntrosEn } from '../../../../../config/series-intros';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter(
    (entry) => entry.data.lang === 'en' && !entry.data.draft && entry.data.series && entry.data.seriesSlug,
  );

  const seriesMap = new Map<string, { title: string }>();

  for (const article of articles) {
    const slug = article.data.seriesSlug!;
    if (!seriesMap.has(slug)) {
      seriesMap.set(slug, { title: article.data.series! });
    }
  }

  return Array.from(seriesMap.entries()).map(([series, data]) => ({
    params: { series },
    props: { seriesSlug: series, seriesTitle: data.title },
  }));
}

const { seriesSlug, seriesTitle } = Astro.props;
const seriesArticles = (await getCollection('articles'))
  .filter(
    (entry) =>
      entry.data.lang === 'en' &&
      !entry.data.draft &&
      entry.data.seriesSlug === seriesSlug,
  )
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

const firstArticle = seriesArticles[0];
const lastArticle = seriesArticles[seriesArticles.length - 1];
const seriesIntro = seriesIntrosEn[seriesSlug];
const seoTitle = buildSeoTitle(seriesTitle, { lang: 'en', section: 'Article Series' });
const seoDescription = buildSeoDescription(
  seriesIntroLead(seriesIntro) ?? `${seriesTitle}: a ${seriesArticles.length}-part series by Dr. Haitham A. El-Ghareeb.`,
  [
    firstArticle?.data.category,
    lastArticle?.data.date ? `Latest part ${lastArticle.data.date}` : undefined,
  ],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">Article Series</p>
      <h1 class="hero__title">{seriesTitle}</h1>
      <p class="hero__lead">
        {seriesIntro ?? `A ${seriesArticles.length}-part series${firstArticle?.data.category ? ` in ${firstArticle.data.category}` : ''}, listed in reading order.`}
      </p>

      <div class="hero__badge-row">
        {seriesIntro && firstArticle?.data.category && <span class="hero__badge">{firstArticle.data.category}</span>}
        <span class="hero__badge">{seriesArticles.length} parts</span>
        {firstArticle?.data.date && <span class="hero__badge">First: {firstArticle.data.date}</span>}
        {lastArticle?.data.date && <span class="hero__badge">Latest: {lastArticle.data.date}</span>}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/articles/series/">All series</a>
        <a class="button-secondary" href="/en/articles/">All articles</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Series parts</p>
        <h2 class="section-title">Read in order</h2>
      </div>

      <div class="grid-two">
        {seriesArticles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'en', article.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[article.data.seriesOrder ? `Part ${article.data.seriesOrder}` : undefined, article.data.date].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
              {article.data.readingTime && <p class="content-card__meta">{article.data.readingTime}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
