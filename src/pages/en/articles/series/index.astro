---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getArticleSeriesPath } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { seriesIntroLead, seriesIntrosEn } from '../../../../../config/series-intros';

const articles = (await getCollection('articles')).filter(
  (entry) => entry.data.lang === 'en' && !entry.data.draft && entry.data.series && entry.data.seriesSlug,
);

const seriesMap = new Map<
  string,
  {
    title: string;
    slug: string;
    count: number;
    latestDate?: string;
    latestTitle?: string;
    category?: string;
  }
>();

for (const article of articles) {
  const slug = article.data.seriesSlug!;
  const existing = seriesMap.get(slug);

  if (!existing) {
    seriesMap.set(slug, {
      title: article.data.series!,
      slug,
      count: 1,
      latestDate: article.data.date,
      latestTitle: article.data.title,
      category: article.data.category,
    });
    continue;
  }

  existing.count += 1;

  const existingTime = existing.latestDate ? new Date(existing.latestDate).getTime() : 0;
  const articleTime = article.data.date ? new Date(article.data.date).getTime() : 0;

  if (articleTime >= existingTime) {
    existing.latestDate = article.data.date;
    existing.latestTitle = article.data.title;
    existing.category = article.data.category;
  }
}

const seriesEntries = Array.from(seriesMap.values()).sort((a, b) => {
  const aTime = a.latestDate ? new Date(a.latestDate).getTime() : 0;
  const bTime = b.latestDate ? new Date(b.latestDate).getTime() : 0;

  return bTime - aTime;
});
const seoTitle = buildSeoTitle('Article Series', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  `${seriesEntries.length} article series: summaries of explanations of al-Shafi'i's al-Risala, Shaykh Salih al-Azhari's manuscript-studies courses, book summaries, and studies in tafsir, spiritual counsel and answering doubts.`,
  [seriesEntries[0]?.latestDate ? `Latest part ${seriesEntries[0].latestDate}` : undefined],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">Article Series</p>
      <h1 class="hero__title">Article Series</h1>
      <p class="hero__lead">
        Summaries of two explanations of al-Shafi'i's al-Risala and of Shaykh Salih al-Azhari's courses in manuscript
        studies; summaries of books by Shaykh Professor Ahmad Abd al-Rahman al-Naqeeb, including his study of Surat al-Saff; and series on
        preparing the heart for Ramadan and on weighing doubts about the Sunnah.
      </p>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/articles/">All articles</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {seriesEntries.map((series) => (
          <a class="card-link" href={getArticleSeriesPath('en', series.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">
                {[series.category, `${series.count} parts`].filter(Boolean).join(' | ')}
              </p>
              <h3>{series.title}</h3>
              {seriesIntrosEn[series.slug] ? (
                <p>{seriesIntroLead(seriesIntrosEn[series.slug])}</p>
              ) : (
                series.latestTitle && <p>Latest part: {series.latestTitle}</p>
              )}
              {series.latestDate && <p class="content-card__meta">Latest part {series.latestDate}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
