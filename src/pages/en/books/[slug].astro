---
import { getCollection, render } from 'astro:content';
import EntityEntryPage from '../../../components/EntityEntryPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryRouteSlug } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

export async function getStaticPaths() {
  const entries = (await getCollection('books')).filter((entry) => entry.data.lang === 'en');

  return entries.map((entry) => ({
    params: { slug: getEntryRouteSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seoTitle = buildSeoTitle(entry.data.title, { lang: 'en', section: 'Books' });
const seoDescription = buildSeoDescription(entry.data.summary, [
  entry.data.workType,
  entry.data.publisher,
  entry.data.year ? `Published ${entry.data.year}` : undefined,
]);
const hostLabels: Record<string, string> = {
  'github.com': 'View on GitHub',
  'www.amazon.com': 'View on Amazon',
  'www.alukah.net': 'View on Alukah',
  'helghareeb.github.io': 'Read online (Arabic)',
};
const externalLabel = entry.data.externalUrl
  ? hostLabels[new URL(entry.data.externalUrl).hostname] ?? 'Open link'
  : undefined;
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <EntityEntryPage
    lang="en"
    eyebrow="Book"
    title={entry.data.title}
    summary={entry.data.summary}
    badges={[entry.data.workType, entry.data.year].filter((value): value is string => Boolean(value))}
    metaItems={[
      { label: 'Status', value: entry.data.status ?? '' },
      ...(entry.data.workType ? [{ label: 'Work type', value: entry.data.workType }] : []),
      ...(entry.data.year ? [{ label: 'Year', value: entry.data.year }] : []),
      ...(entry.data.publisher ? [{ label: 'Publisher', value: entry.data.publisher }] : []),
    ]}
    backHref="/en/books/"
    backLabel="Back to books"
    externalUrl={entry.data.externalUrl}
    externalLabel={externalLabel}
  >
    <Content />
  </EntityEntryPage>
</BaseLayout>
