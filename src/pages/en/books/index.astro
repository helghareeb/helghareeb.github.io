---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const books = (await getCollection('books'))
  .filter((entry) => entry.data.lang === 'en')
  .sort((a, b) => {
    const yearDiff = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearDiff !== 0) return yearDiff;

    return a.data.title.localeCompare(b.data.title, 'en');
  });

const groupOrder = ['Book', 'E-Book'];
const groupLabels: Record<string, string> = {
  Book: 'Books',
  'E-Book': 'E-books: edited lesson transcriptions',
};
const groupMap = new Map<string, typeof books>();

for (const book of books) {
  const key = book.data.workType ?? 'Other works';
  groupMap.set(key, [...(groupMap.get(key) ?? []), book]);
}

const groups = Array.from(groupMap.entries()).sort((a, b) => {
  const aIndex = groupOrder.indexOf(a[0]);
  const bIndex = groupOrder.indexOf(b[0]);

  return (aIndex === -1 ? groupOrder.length : aIndex) - (bIndex === -1 ? groupOrder.length : bIndex);
});

const seoTitle = buildSeoTitle('Books', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'Books by Dr. Haitham A. El-Ghareeb: academic monographs on service-oriented architecture and enterprise integration, information systems textbooks, and Islamic studies titles.',
  [`${books.length} titles`, books[0]?.data.year ? `Latest ${books[0].data.year}` : undefined],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Books</p>
      <h1 class="hero__title">Books</h1>
      <p class="hero__lead">
        Monographs on service-oriented architecture, e-learning and enterprise integration, course
        textbooks in information systems, a collection of Arabic short stories, and edited transcriptions
        of lessons on al-Shafi'i's al-Risalah and al-Tabari's Tafsir, listed newest first.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">{books.length} titles</span>
      </div>
    </section>

    {groups.map(([workType, entries]) => (
      <section class="shell section">
        <div class="section-heading">
          <h2 class="section-title">{groupLabels[workType] ?? workType} ({entries.length})</h2>
        </div>

        <div class="grid-two">
          {entries.map((book) => (
            <a class="card-link" href={getEntryPath('books', 'en', book.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[book.data.year, book.data.publisher].filter(Boolean).join(' | ')}</p>
                <h3>{book.data.title}</h3>
                <p>{book.data.summary}</p>
                {book.data.status && <p class="content-card__meta">{book.data.status}</p>}
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
