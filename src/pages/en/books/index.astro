---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const books = (await getCollection('books'))
  .filter((entry) => entry.data.lang === 'en')
  .sort((a, b) => {
    const yearDiff = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearDiff !== 0) return yearDiff;

    return a.data.title.localeCompare(b.data.title, 'en');
  });

// Books are grouped by subject.
const groupOrder = ['Information Systems and Computing', 'Islamic Studies', 'Education and Literature'];
const groupId: Record<string, string> = {
  'Information Systems and Computing': 'computing',
  'Islamic Studies': 'islamic-studies',
  'Education and Literature': 'education',
};
const groupMap = new Map<string, typeof books>();

for (const book of books) {
  const key = book.data.category ?? 'Other works';
  groupMap.set(key, [...(groupMap.get(key) ?? []), book]);
}

const rank = (key: string) => {
  const index = groupOrder.indexOf(key);
  return index === -1 ? groupOrder.length : index;
};
const groups = Array.from(groupMap.entries())
  .sort((a, b) => rank(a[0]) - rank(b[0]))
  .map(([key, entries]) => ({ key, id: groupId[key] ?? 'other', title: key, entries }));

const seoTitle = buildSeoTitle('Books', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'Books by Dr. Haitham A. El-Ghareeb: academic monographs on service-oriented architecture and enterprise integration, information systems textbooks, and Islamic studies titles.',
  [`${books.length + 1} titles`, books[0]?.data.year ? `Latest ${books[0].data.year}` : undefined],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Books</p>
      <h1 class="hero__title">Books</h1>
      <p class="hero__lead">
        Monographs on service-oriented architecture, e-learning and enterprise integration, course
        textbooks in information systems, Arabic works in creed and Islamic studies, a collection of
        Arabic short stories, and edited transcriptions of lessons on al-Shafi'i's al-Risalah and
        al-Tabari's Tafsir, grouped by subject and listed newest first.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">{books.length + 1} titles</span>
      </div>
    </section>

    <nav class="shell books-nav" aria-label="Book categories">
      {groups.map((group) => (
        <a class="hero__badge" href={`#${group.id}`}>{group.title} ({group.entries.length + (group.id === 'islamic-studies' ? 1 : 0)})</a>
      ))}
    </nav>

    {groups.map((group) => (
      <section class="shell section" id={group.id}>
        <div class="section-heading">
          <h2 class="section-title">{group.title}</h2>
        </div>

        <div class="grid-two">
          {group.id === 'islamic-studies' && (
            <a class="card-link" href="/en/mushaf-gharib/">
              <article class="content-card entity-card">
                <p class="content-card__meta">Book · read and download (PDF)</p>
                <h3>Mushaf al-Gharib</h3>
                <p>
                  The Madina mushaf (Hafs) with a facing commentary page for every page: rare words from six
                  classical books, occasions of revelation, and the tafsir hadiths with their grades. Thirty-one
                  volumes and a single complete file, in Arabic.
                </p>
              </article>
            </a>
          )}
          {group.entries.map((book) => (
            <a class="card-link" href={getEntryPath('books', 'en', book.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[book.data.year, book.data.publisher].filter(Boolean).join(' | ')}</p>
                <h3>{book.data.title}</h3>
                <p>{book.data.summary}</p>
                {book.data.status && <p class="content-card__meta">{book.data.status}</p>}
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
