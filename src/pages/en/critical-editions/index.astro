---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const editions = (await getCollection('editions'))
  .filter((entry) => entry.data.lang === 'en')
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0));

const manuscriptArticles = (await getCollection('articles'))
  .filter(
    (entry) =>
      entry.data.lang === 'en' &&
      !entry.data.draft &&
      (/manuscript|tashif|al-tawdih/i.test(entry.data.title) || entry.data.category === 'Textual Scholarship Methodologies'),
  )
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));

const seoTitle = buildSeoTitle('Critical Editions', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'Critical editions of Arabic manuscripts by Dr. Haitham A. El-Ghareeb, including al-Tawdih lil-Awham al-Waqi\'a fi al-Sahih by Sibt Ibn al-\'Ajami.',
  [`${editions.length} ${editions.length === 1 ? 'edition' : 'editions'}`],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Critical Editions</p>
      <h1 class="hero__title">Critical Editions</h1>
      <p class="hero__lead">
        A critical edition, from a rare manuscript, of a ninth-century AH study of the transmissions
        and copies of Sahih al-Bukhari, edited under the supervision and review of Shaykh Salih ibn
        Muhammad al-Azhari.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {editions.map((edition) => (
          <a class="card-link" href={getEntryPath('editions', 'en', edition.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{[edition.data.workType, edition.data.year, edition.data.status].filter(Boolean).join(' | ')}</p>
              <h3>{edition.data.title}</h3>
              <p>{edition.data.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>

    {manuscriptArticles.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">Related reading</p>
          <h2 class="section-title">Articles on manuscripts and textual criticism</h2>
        </div>

        <div class="grid-two">
          {manuscriptArticles.map((article) => (
            <a class="card-link" href={getEntryPath('articles', 'en', article.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[article.data.category, article.data.date].filter(Boolean).join(' | ')}</p>
                <h3>{article.data.title}</h3>
                <p>{article.data.summary}</p>
              </article>
            </a>
          ))}
        </div>

        <div class="hero__actions">
          <a class="button-secondary" href="/en/scholarly-fields/manuscripts/">Manuscripts field</a>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
