---
import { getCollection, render } from 'astro:content';
import EntityEntryPage from '../../../components/EntityEntryPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryRouteSlug } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

export async function getStaticPaths() {
  const entries = (await getCollection('externalLinks')).filter((entry) => entry.data.lang === 'en');

  return entries.map((entry) => ({
    params: { slug: getEntryRouteSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seoTitle = buildSeoTitle(entry.data.title, { lang: 'en', section: 'External Links' });
const seoDescription = buildSeoDescription(entry.data.summary, [entry.data.sourceName, entry.data.category]);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <EntityEntryPage
    lang="en"
    eyebrow="External Link"
    title={entry.data.title}
    summary={entry.data.summary}
    badges={[entry.data.category, entry.data.sourceName].filter((value): value is string => Boolean(value))}
    metaItems={[
      ...(entry.data.sourceName ? [{ label: 'Source', value: entry.data.sourceName }] : []),
      ...(entry.data.linkType ? [{ label: 'Type', value: entry.data.linkType }] : []),
    ]}
    backHref="/en/external-links/"
    backLabel="Back to external links"
    externalUrl={entry.data.externalUrl}
    externalLabel={entry.data.sourceName ? `Open on ${entry.data.sourceName}` : 'Open link'}
  >
    <Content />
  </EntityEntryPage>
</BaseLayout>
