---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const links = (await getCollection('externalLinks'))
  .filter((entry) => entry.data.lang === 'en')
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;

    return a.data.title.localeCompare(b.data.title, 'en');
  });

const categoryMap = new Map<string, typeof links>();

for (const link of links) {
  const category = link.data.category ?? 'Other links';
  categoryMap.set(category, [...(categoryMap.get(category) ?? []), link]);
}

const categories = Array.from(categoryMap.entries()).sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'en'),
);
const seoTitle = buildSeoTitle('External Links', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'Research profiles, publishing platforms, journal and university pages, and external publications of Dr. Haitham A. El-Ghareeb.',
  [`${links.length} links`],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">External Links</p>
      <h1 class="hero__title">External Links</h1>
      <p class="hero__lead">
        Research profiles, author pages on publishing platforms, university and journal pages, and
        articles and books published on other websites.
      </p>
    </section>

    {categories.map(([category, entries]) => (
      <section class="shell section">
        <div class="section-heading">
          <h2 class="section-title">{category}</h2>
        </div>

        <div class="grid-two">
          {entries.map((link) => (
            <a class="card-link" href={getEntryPath('externalLinks', 'en', link.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[link.data.sourceName, link.data.linkType].filter(Boolean).join(' | ')}</p>
                <h3>{link.data.title}</h3>
                <p>{link.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
