---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getEntryPath } from '../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../utils/seo';

const toTime = (value?: string) => (value ? new Date(value).getTime() : 0);

const allBooks = (await getCollection('books'))
  .filter((entry) => entry.data.lang === 'en')
  .sort((a, b) => {
    const yearDiff = Number(b.data.year ?? 0) - Number(a.data.year ?? 0);
    if (yearDiff !== 0) return yearDiff;

    return a.data.title.localeCompare(b.data.title, 'en');
  });
const featuredBooks = allBooks.slice(0, 4);

const featuredEditions = (await getCollection('editions')).filter((entry) => entry.data.lang === 'en');

const allArticles = (await getCollection('articles'))
  .filter((entry) => entry.data.lang === 'en' && !entry.data.draft)
  .sort((a, b) => toTime(b.data.date) - toTime(a.data.date));
const latestArticles = allArticles.slice(0, 3);
const seriesCount = new Set(
  allArticles.map((entry) => entry.data.seriesSlug).filter((slug): slug is string => Boolean(slug)),
).size;

const featuredProjects = (await getCollection('projects')).filter((entry) => entry.data.lang === 'en');

const featuredFields = (await getCollection('fields'))
  .filter((entry) => entry.data.lang === 'en' && entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const featuredLinks = (await getCollection('externalLinks'))
  .filter((entry) => entry.data.lang === 'en' && entry.data.featured && entry.data.category === 'Research Profiles')
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'))
  .slice(0, 3);

const seoTitle = buildSeoTitle('Dr. Haitham A. El-Ghareeb', {
  lang: 'en',
  section: 'Associate Professor of Information Systems',
});
const seoDescription = buildSeoDescription(
  'Dr. Haitham A. El-Ghareeb, Associate Professor of Information Systems at Mansoura University: books, a critical edition, and articles on the Sunnah, Islamic legal theory and manuscript heritage.',
  [`${allArticles.length} English articles`, `${allBooks.length} books`],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main page-main--home">
    <section class="shell hero hero--home">
      <p class="hero__eyebrow">Associate Professor of Information Systems · Mansoura University</p>
      <h1 class="hero__title">Dr. Haitham A. El-Ghareeb</h1>
      <p class="hero__lead">
        Associate Professor of Information Systems at Mansoura University and Managing Editor of the
        Mansoura Journal for Computer and Information Sciences. He writes on the Sunnah, Islamic legal
        theory and manuscript heritage, and authors course textbooks in information systems.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">Information Systems</span>
        <span class="hero__badge">Hadith and the Sunnah</span>
        <span class="hero__badge">Islamic Legal Theory</span>
        <span class="hero__badge">Manuscripts and Critical Editions</span>
      </div>

      <div class="hero__actions">
        <a class="button" href="/en/cv/">View CV</a>
        <a class="button-secondary" href="/en/books/">Books</a>
        <a class="button-secondary" href="/en/critical-editions/">Critical Editions</a>
        <a class="button-secondary" href="/en/articles/">Articles</a>
      </div>

      <div class="grid-three hero__stats">
        <a class="card-link" href="/en/articles/">
          <article class="stat-card">
            <strong>{allArticles.length}</strong>
            <span>English articles, most first published in Arabic on the Alukah Network.</span>
          </article>
        </a>
        <a class="card-link" href="/en/books/">
          <article class="stat-card">
            <strong>{allBooks.length}</strong>
            <span>Books, from academic monographs and course textbooks to edited lesson transcriptions.</span>
          </article>
        </a>
        <a class="card-link" href="/en/articles/series/">
          <article class="stat-card">
            <strong>{seriesCount}</strong>
            <span>Article series that can be read in order from first part to last.</span>
          </article>
        </a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Articles</p>
        <h2 class="section-title">Latest articles</h2>
      </div>

      <div class="grid-three">
        {latestArticles.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'en', article.slug)}>
            <article class="content-card">
              <p class="content-card__meta">
                {[article.data.category, article.data.date].filter(Boolean).join(' | ')}
              </p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/articles/">All articles</a>
        <a class="button-secondary" href="/en/articles/series/">Article series</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Scholarly fields</p>
        <h2 class="section-title">Areas of work</h2>
      </div>

      <div class="grid-three">
        {featuredFields.map((field) => (
          <a class="card-link" href={field.data.href}>
            <article class="feature-card feature-card--field">
              <h3>{field.data.title}</h3>
              <p>{field.data.summary}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/scholarly-fields/">All scholarly fields</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Books</p>
        <h2 class="section-title">Recent books</h2>
      </div>

      <div class="grid-two">
        {featuredBooks.map((book) => (
          <a class="card-link" href={getEntryPath('books', 'en', book.slug)}>
            <article class="content-card">
              <p class="content-card__meta">{[book.data.workType, book.data.year].filter(Boolean).join(' | ')}</p>
              <h3>{book.data.title}</h3>
              <p>{book.data.summary}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/books/">All books</a>
      </div>
    </section>

    {featuredEditions.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">Critical Editions</p>
          <h2 class="section-title">Critical edition</h2>
        </div>

        <div class="grid-two">
          {featuredEditions.map((edition) => (
            <a class="card-link" href={getEntryPath('editions', 'en', edition.slug)}>
              <article class="content-card">
                <p class="content-card__meta">{[edition.data.workType, edition.data.year].filter(Boolean).join(' | ')}</p>
                <h3>{edition.data.title}</h3>
                <p>{edition.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Projects and research profiles</p>
        <h2 class="section-title">Open-source work and research profiles</h2>
      </div>

      <div class="grid-three">
        {featuredProjects.map((project) => (
          <a class="card-link" href={getEntryPath('projects', 'en', project.slug)}>
            <article class="content-card">
              <p class="content-card__meta">{[project.data.area, project.data.startYear].filter(Boolean).join(' | ')}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
            </article>
          </a>
        ))}
        {featuredLinks.map((link) => (
          <a class="card-link" href={getEntryPath('externalLinks', 'en', link.slug)}>
            <article class="content-card">
              <p class="content-card__meta">{link.data.sourceName ?? link.data.category}</p>
              <h3>{link.data.title}</h3>
              <p>{link.data.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>

    <section class="shell cta-panel">
      <div>
        <p class="section-kicker">Study Hub</p>
        <h2 class="section-title">Notes from the study circles</h2>
        <p class="section-copy">
          Edited study notes from lessons on al-Shafi'i's al-Risalah and on al-Tabari's commentary on
          al-Fatihah and al-Baqarah, together with a suggested sequence for students of Islamic knowledge.
        </p>
      </div>
      <div class="hero__actions">
        <a class="button" href="/en/study/">Study Hub</a>
        <a class="button-secondary" href="/en/learning-path/">Learning Path</a>
        <a class="button-secondary" href="/en/projects/">Projects</a>
      </div>
    </section>
  </main>
</BaseLayout>
