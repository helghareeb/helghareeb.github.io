---
import { getCollection, render } from 'astro:content';
import EntityEntryPage from '../../../components/EntityEntryPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryRouteSlug } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

export async function getStaticPaths() {
  const entries = (await getCollection('projects')).filter((entry) => entry.data.lang === 'en');

  return entries.map((entry) => ({
    params: { slug: getEntryRouteSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seoTitle = buildSeoTitle(entry.data.title, { lang: 'en', section: 'Projects' });
const seoDescription = buildSeoDescription(entry.data.summary, [
  entry.data.area,
  entry.data.status,
  entry.data.startYear ? `Started ${entry.data.startYear}` : undefined,
]);
const hostLabels: Record<string, string> = {
  'github.com': 'View on GitHub',
  'www.amazon.com': 'View on Amazon',
  'www.alukah.net': 'View on Alukah',
  'helghareeb.github.io': 'Read online (Arabic)',
};
const externalLabel = entry.data.externalUrl
  ? hostLabels[new URL(entry.data.externalUrl).hostname] ?? 'Open link'
  : undefined;
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <EntityEntryPage
    lang="en"
    eyebrow="Project"
    title={entry.data.title}
    summary={entry.data.summary}
    badges={[entry.data.area, entry.data.status].filter((value): value is string => Boolean(value))}
    metaItems={[
      { label: 'Status', value: entry.data.status ?? '' },
      ...(entry.data.area ? [{ label: 'Area', value: entry.data.area }] : []),
      ...(entry.data.startYear ? [{ label: 'Start year', value: entry.data.startYear }] : []),
    ]}
    backHref="/en/projects/"
    backLabel="Back to projects"
    externalUrl={entry.data.externalUrl}
    externalLabel={externalLabel}
  >
    <Content />
  </EntityEntryPage>
</BaseLayout>
