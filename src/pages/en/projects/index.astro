---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { getEntryPath } from '../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.lang === 'en')
  .sort((a, b) => Number(b.data.startYear ?? 0) - Number(a.data.startYear ?? 0));
const seoTitle = buildSeoTitle('Projects', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'Open-source projects by Dr. Haitham A. El-Ghareeb, including this bilingual website and public course repositories.',
  [`${projects.length} projects`],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Projects</p>
      <h1 class="hero__title">Projects</h1>
      <p class="hero__lead">
        Open-source work published on GitHub: the source of this bilingual website and public
        repositories for university courses.
      </p>

      <div class="hero__actions">
        <a class="button-secondary" href="https://github.com/helghareeb">GitHub profile</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {projects.map((project) => (
          <a class="card-link" href={getEntryPath('projects', 'en', project.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{[project.data.area, project.data.startYear].filter(Boolean).join(' | ')}</p>
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
              {project.data.status && <p class="content-card__meta">{project.data.status}</p>}
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
