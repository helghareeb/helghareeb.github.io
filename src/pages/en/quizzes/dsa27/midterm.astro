---
import ExamSimulator from '../../../../components/ExamSimulator.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { DSA27_REPO, getDsa27WeekPath, getQuizIndexPath, midtermWeeks, quizLabels } from '../../../../utils/quizzes';

const t = quizLabels.en;
const weeks = midtermWeeks();
const mcqs = weeks.reduce((sum, week) => sum + week.questions.length, 0);
const essays = weeks.reduce((sum, week) => sum + (week.essays?.length ?? 0), 0);
const seoTitle = buildSeoTitle('DSA27 Midterm Exam Simulator', { lang: 'en', section: t.section });
const seoDescription = buildSeoDescription(
  `Timed practice midterms for Data Structures and Algorithms (DSA27), Lectures 1 to ${weeks.length}: up to 60 questions drawn from ${mcqs} multiple-choice and ${essays} written questions, with a detailed report.`,
  [],
);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">{t.course} · Lectures 1–{weeks.length}</p>
      <h1 class="hero__title">{t.midterm}</h1>
      <p class="hero__lead">
        Every paper is drawn fresh from the course question bank: {mcqs} multiple-choice questions and {essays}
        written questions on Lectures 1 to {weeks.length}. Pick a paper, sit it against the clock, and get a report
        by lecture and by level, with every answer explained. {t.practiceNote}
      </p>
      <div class="hero__actions">
        <a class="button-secondary" href={getQuizIndexPath('en')}>{t.section}</a>
        <a class="button-secondary" href={getDsa27WeekPath('en', 1)}>{t.week(1)}</a>
        <a class="button-secondary" href={DSA27_REPO}>{t.repo}</a>
      </div>
    </section>

    <section class="shell section">
      <ExamSimulator lang="en" />
    </section>

    <section class="shell section">
      <article class="notice-card exam__tips">
        <h2>How to train with it</h2>
        <ol>
          <li><strong>Start with a Half paper</strong> in exam mode, closed book, to find out where you stand.</li>
          <li>
            Read the report. For every lecture under 60%, go back to its handout and its interactive lab, then do
            that week's quiz and written questions.
          </li>
          <li>Use <strong>My weak spots</strong> and <strong>My mistakes</strong> until the same questions stop coming back.</li>
          <li>
            Train the written part too: the <strong>Exam format</strong> paper has a 30-mark written section. Write
            your answers, then mark yourself against the marking points, honestly.
          </li>
          <li>In the last days, sit a <strong>Full midterm</strong> in one go, timed, with your phone away. Aim for 60% or more.</li>
          <li>Studying in a group? Share a <strong>paper code</strong>: with the same code and settings, everyone gets the same paper.</li>
        </ol>
        <p>The real midterm's format and date are announced in the lecture and on the course WhatsApp channel.</p>
      </article>
    </section>
  </main>
</BaseLayout>
