---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getEntryPath } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';

const links = (await getCollection('externalLinks')).filter((entry) => entry.data.lang === 'en');
const findLink = (routeSlug: string) => links.find((entry) => entry.slug === `${routeSlug}-en`);
const journalLink = findLink('mjcis-journal');
const defenseLink = findLink('mansoura-phd-defense-committee');
const facultyPostLink = findLink('faculty-facebook-post');

const roles = [
  {
    period: 'Since 24 September 2026',
    title: 'Managing Editor',
    venue: 'Mansoura Journal for Computer and Information Sciences (MJCIS), Mansoura University',
    href: journalLink ? getEntryPath('externalLinks', 'en', journalLink.slug) : undefined,
  },
  {
    period: 'Since April 2023',
    title: 'Editorial Board Member',
    venue: 'Mansoura Journal for Computer and Information Sciences (MJCIS)',
    href: journalLink ? getEntryPath('externalLinks', 'en', journalLink.slug) : undefined,
  },
  {
    period: '2009–2013',
    title: 'Technical Editor and Reviewer',
    venue: 'Advances in Information Sciences and Service Sciences (AISS)',
  },
  {
    period: 'Former',
    title: 'IT Editorial Board Member and Educational Reviewer',
    venue: 'MERLOT (Multimedia Educational Resource for Learning and Online Teaching)',
  },
  ...(facultyPostLink
    ? [
        {
          period: '15 September 2022',
          title: 'Member of a Ph.D. examination committee: Knowledge Discovery Technique for Medical Big Data',
          venue: 'Faculty of Computers and Information, Mansoura University',
          href: getEntryPath('externalLinks', 'en', facultyPostLink.slug),
        },
      ]
    : []),
  ...(defenseLink
    ? [
        {
          period: 'July 2023',
          title: 'Member of a Ph.D. examination committee: A Proposed Framework for Outlier Detection of Stream Data',
          venue: 'Information Systems, Faculty of Computers and Information, Mansoura University',
          href: getEntryPath('externalLinks', 'en', defenseLink.slug),
        },
      ]
    : []),
];

const seoTitle = buildSeoTitle('Academic Reviewing', {
  lang: 'en',
  section: 'Scholarly Fields',
});
const seoDescription = buildSeoDescription(
  'Editorial and reviewing roles of Dr. Haitham A. El-Ghareeb: Managing Editor of MJCIS, AISS technical editor and reviewer, former MERLOT educational reviewer, and Ph.D. examination committee member.',
  [],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main page-main--detail">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Academic Reviewing</p>
      <h1 class="hero__title">Academic Reviewing</h1>
      <p class="hero__lead">
        Editorial and reviewing work for journals in computer and information sciences and for
        educational resources, together with doctoral examination in information systems.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {roles.map((role) => (
          <article class="content-card entity-card">
            {role.period && <p class="content-card__meta">{role.period}</p>}
            <h3>{role.href ? <a href={role.href}>{role.title}</a> : role.title}</h3>
            <p>{role.venue}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
