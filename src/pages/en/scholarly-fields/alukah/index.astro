---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getEntryPath } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';

const toTime = (value?: string) => (value ? new Date(value).getTime() : 0);

const alukahArticles = (await getCollection('articles'))
  .filter((entry) => entry.data.lang === 'en' && !entry.data.draft && entry.data.sourceName === 'Alukah Network')
  .sort((a, b) => toTime(b.data.date) - toTime(a.data.date));
const latest = alukahArticles.slice(0, 6);

const alukahBooks = (await getCollection('books')).filter(
  (entry) => entry.data.lang === 'en' && (entry.data.externalUrl ?? '').includes('alukah.net'),
);

const seoTitle = buildSeoTitle('Alukah', {
  lang: 'en',
  section: 'Scholarly Fields',
});
const seoDescription = buildSeoDescription(
  'Articles and books by Dr. Haitham A. El-Ghareeb published on the Alukah Network, with English versions on this site.',
  [`${alukahArticles.length} articles`, alukahArticles[0]?.data.date ? `Latest ${alukahArticles[0].data.date}` : undefined],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main page-main--detail">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Alukah</p>
      <h1 class="hero__title">Writing on the Alukah Network</h1>
      <p class="hero__lead">
        Dr. Haitham A. El-Ghareeb publishes articles and books in Arabic on the Alukah Network.
        {alukahArticles.length} of these articles are available here in English, each linked to its
        Arabic original.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">{alukahArticles.length} articles in English</span>
      </div>

      <div class="hero__actions">
        <a class="button" href="/en/scholarly-fields/alukah/articles/">All Alukah articles</a>
        <a class="button-secondary" href="https://www.alukah.net/authors/view/home/16869/">Author page on Alukah</a>
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Latest</p>
        <h2 class="section-title">Latest Alukah articles</h2>
      </div>

      <div class="grid-two">
        {latest.map((article) => (
          <a class="card-link" href={getEntryPath('articles', 'en', article.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{[article.data.category, article.data.date].filter(Boolean).join(' | ')}</p>
              <h3>{article.data.title}</h3>
              <p>{article.data.summary}</p>
            </article>
          </a>
        ))}
      </div>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/scholarly-fields/alukah/articles/">Full list of {alukahArticles.length} articles</a>
      </div>
    </section>

    {alukahBooks.length > 0 && (
      <section class="shell section">
        <div class="section-heading">
          <p class="section-kicker">Books</p>
          <h2 class="section-title">Books in the Alukah library</h2>
        </div>

        <div class="grid-two">
          {alukahBooks.map((book) => (
            <a class="card-link" href={getEntryPath('books', 'en', book.slug)}>
              <article class="content-card entity-card">
                <p class="content-card__meta">{[book.data.workType, book.data.year].filter(Boolean).join(' | ')}</p>
                <h3>{book.data.title}</h3>
                <p>{book.data.summary}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
