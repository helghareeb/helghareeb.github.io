---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';

const articles = (await getCollection('articles')).filter((entry) => entry.data.lang === 'en' && !entry.data.draft);
const alukahCount = articles.filter((entry) => entry.data.sourceName === 'Alukah Network').length;
const hadithCount = articles.filter((entry) => entry.data.category === 'Hadith and Hadith Sciences').length;

const fieldCards = [
  {
    title: 'Islamic Studies',
    copy: `Articles on hadith, creed, Qur'anic exegesis, legal theory and counsel, including ${hadithCount} on hadith and its sciences, with study notes from the lessons.`,
    href: '/en/scholarly-fields/islamic-studies/',
  },
  {
    title: 'Defense of the Sunnah',
    copy: 'The Mizan Series on how to weigh doubts, a summary of "Why I Did Not Become Shia", and articles answering objections to the Sunnah and its transmitters.',
    href: '/en/scholarly-fields/defense-of-sunnah/',
  },
  {
    title: 'Alukah',
    copy: `${alukahCount} articles first published in Arabic on the Alukah Network, available here in English.`,
    href: '/en/scholarly-fields/alukah/',
  },
  {
    title: 'Manuscripts',
    copy: "A critical edition of al-Tawdih lil-Awham, articles on variants in the copies of Sahih al-Bukhari, and notes (in Arabic) from Shaykh Salih al-Azhari's manuscript courses.",
    href: '/en/scholarly-fields/manuscripts/',
  },
  {
    title: 'AI and Islamic Heritage',
    copy: 'Articles on artificial intelligence and technology in the service of the Islamic sciences and Islamic education.',
    href: '/en/scholarly-fields/ai-and-islamic-heritage/',
  },
  {
    title: 'Academic Reviewing',
    copy: 'Editorial and reviewing roles with MJCIS, AISS and MERLOT, and membership of a doctoral examination committee.',
    href: '/en/scholarly-fields/academic-reviewing/',
  },
  {
    title: 'E-Learning',
    copy: 'Books on service-oriented architecture for e-learning, open course textbooks, and digital study tools for Islamic learning.',
    href: '/en/scholarly-fields/e-learning/',
  },
];
const seoTitle = buildSeoTitle('Scholarly Fields', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  'Islamic studies, defense of the Sunnah, Alukah articles, manuscripts, AI and Islamic heritage, academic reviewing and e-learning.',
  [`${fieldCards.length} fields`],
);
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={seoTitle}
  description={seoDescription}
>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">Scholarly Fields</p>
      <h1 class="hero__title">Scholarly Fields</h1>
      <p class="hero__lead">
        The areas in which Dr. Haitham A. El-Ghareeb writes, edits and teaches, from hadith and
        manuscripts to e-learning and academic reviewing.
      </p>

      <div class="hero__actions">
        <a class="button" href="/en/articles/">Browse articles</a>
        <a class="button-secondary" href="/en/learning-path/">Suggested learning path</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-three">
        {fieldCards.map((field) => (
          <a class="card-link" href={field.href}>
            <article class="feature-card feature-card--field">
              <h3>{field.title}</h3>
              <p>{field.copy}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
