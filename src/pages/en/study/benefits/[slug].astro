---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntityEntryPage from '../../../../components/EntityEntryPage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { getStudyBenefitBookPath, getStudyBenefitRouteSlug } from '../../../../utils/study';

export async function getStaticPaths() {
  const entries = (await getCollection('studyBenefits')).filter((entry) => entry.data.lang === 'en' && !entry.data.draft);

  return entries.map((entry) => ({
    params: { slug: getStudyBenefitRouteSlug(entry.slug) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'studyBenefits'> };
const { Content } = await render(entry);
const seoTitle = buildSeoTitle(entry.data.title, {
  lang: 'en',
  section: 'Benefits from Books',
});
const seoDescription = buildSeoDescription(entry.data.summary, [
  entry.data.field,
  entry.data.bookTitle,
  entry.data.teacher,
]);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <EntityEntryPage
    lang="en"
    eyebrow="Study notebook"
    title={entry.data.title}
    summary={entry.data.summary}
    badges={[entry.data.field, entry.data.bookTitle, entry.data.teacher].filter((value): value is string => Boolean(value))}
    metaItems={[
      { label: 'Subject', value: entry.data.field },
      { label: 'Book', value: entry.data.bookTitle },
      ...(entry.data.teacher ? [{ label: 'Teacher', value: entry.data.teacher }] : []),
      ...(entry.data.sourceSeries ? [{ label: 'Lessons', value: entry.data.sourceSeries }] : []),
    ]}
    backHref={getStudyBenefitBookPath('en', entry.data.fieldSlug, entry.data.bookSlug)}
    backLabel={`All notes on ${entry.data.bookTitle}`}
  >
    <section class="notice-card">
      <p class="entity-kicker">Editorial note</p>
      <p>
        These notes were compiled and edited from the lessons; they have not been reviewed by the
        teacher, and any error is the compiler's.
      </p>
    </section>

    <Content />
  </EntityEntryPage>
</BaseLayout>
