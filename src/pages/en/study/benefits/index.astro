---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';
import { getEntryPath } from '../../../../utils/content-routing';
import { getStudyBenefitBookPath, groupStudyBenefits, getStudyBenefitRouteSlug } from '../../../../utils/study';

const publishedBenefits = (await getCollection('studyBenefits')).filter(
  (entry) => entry.data.lang === 'en' && !entry.data.draft,
);
const groupedBenefits = groupStudyBenefits(publishedBenefits);

const seoTitle = buildSeoTitle('Benefits from Books', {
  lang: 'en',
  section: 'Study Hub',
});
const seoDescription = buildSeoDescription(
  "Edited study notes from lessons on al-Shafi'i's al-Risalah and al-Tabari's commentary on al-Fatihah and al-Baqarah, arranged by subject and teacher.",
  [`${publishedBenefits.length} notebooks`, `${groupedBenefits.length} subject and teacher groups`],
);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Benefits from Books</p>
      <h1 class="hero__title">Benefits from Books</h1>
      <p class="hero__lead">
        Notes from lessons on al-Shafi'i's al-Risalah by Dr. Ahmad al-Naqeeb, Shaykh Samy al-'Arabi and
        Shaykh Husayn Abd al-Raziq, and on al-Tabari's commentary on al-Fatihah and al-Baqarah by Shaykh
        Husayn Abd al-Raziq, arranged by subject.
      </p>

      <div class="hero__badge-row">
        <span class="hero__badge">{publishedBenefits.length} notebooks</span>
      </div>
    </section>

    <section class="shell notice-card">
      <p>
        These notes were compiled and edited from the lessons; they have not been reviewed by the
        teacher, and any error is the compiler's.
      </p>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">By subject</p>
        <h2 class="section-title">Notebooks by subject, book and teacher</h2>
      </div>

      {groupedBenefits.length > 0 && (
        <div class="grid-two">
          {groupedBenefits.map((group) => (
            <article class="content-card entity-card">
              <p class="content-card__meta">{group.field}</p>
              <h3>
                <a href={getStudyBenefitBookPath('en', group.fieldSlug, group.bookSlug)}>{group.bookTitle}</a>
              </h3>
              {group.teacher && <p>{group.teacher}</p>}
              <p class="content-card__meta">{group.entries.length} {group.entries.length === 1 ? 'notebook' : 'notebooks'}</p>
              <ul class="entity-list">
                {group.entries.map((entry) => (
                  <li>
                    <a href={getEntryPath('studyBenefits', 'en', getStudyBenefitRouteSlug(entry.slug))}>{entry.data.title}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
