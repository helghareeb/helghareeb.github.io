---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import '../../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../../utils/seo';

export async function getStaticPaths() {
  const decks = await getCollection('flashcardDecks');

  return decks
    .filter((entry) => entry.data.lang === 'en' && !entry.data.draft)
    .map((entry) => ({
      params: { book: entry.slug.replace(/-(ar|en)$/, '') },
      props: { deck: entry },
    }));
}

const { deck } = Astro.props as { deck: CollectionEntry<'flashcardDecks'> };
const deckRouteSlug = deck.slug.replace(/-(ar|en)$/, '');
const cards = (await getCollection('flashcards')).filter(
  (entry) => entry.data.lang === 'ar' && !entry.data.draft && entry.data.deckSlug === deckRouteSlug,
);
const counts = {
  review: cards.filter((card) => card.data.mode === 'review').length,
  training: cards.filter((card) => card.data.mode === 'training').length,
  test: cards.filter((card) => card.data.mode === 'test').length,
};
const arabicPath = (mode?: 'review' | 'training' | 'test' | 'results') =>
  `/ar/study/flashcards/${deckRouteSlug}/${mode ? `${mode}/` : ''}`;
const seoTitle = buildSeoTitle(deck.data.title, {
  lang: 'en',
  section: 'Flashcards',
});
const seoDescription = buildSeoDescription(deck.data.summary, [
  deck.data.field,
  `${cards.length} questions in Arabic`,
]);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Flashcards</p>
      <h1 class="hero__title">{deck.data.bookTitle}</h1>
      <p class="hero__lead">{deck.data.summary}</p>

      <div class="hero__badge-row">
        <span class="hero__badge">{deck.data.field}</span>
        <span class="hero__badge">{cards.length} questions in Arabic</span>
      </div>

      <div class="hero__actions">
        <a class="button" href={arabicPath()}>Open the deck (Arabic)</a>
      </div>
    </section>

    <section class="shell notice-card">
      <p>
        The questions and answers in this deck are in Arabic. Each mode below opens the Arabic version
        of the deck.
      </p>
    </section>

    <section class="shell section">
      <div class="grid-two">
        <a class="card-link" href={arabicPath('review')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">{counts.review} cards</p>
            <h3>Review</h3>
            <p>See each question together with its answer before moving on to active recall.</p>
          </article>
        </a>
        <a class="card-link" href={arabicPath('training')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">{counts.training} questions</p>
            <h3>Training</h3>
            <p>Try to recall the answer first, then reveal it and mark whether you knew it.</p>
          </article>
        </a>
        <a class="card-link" href={arabicPath('test')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">{counts.test} questions</p>
            <h3>Test</h3>
            <p>Work through the questions as an assessment to measure what you have retained.</p>
          </article>
        </a>
        <a class="card-link" href={arabicPath('results')}>
          <article class="content-card entity-card">
            <p class="content-card__meta">Saved in your browser</p>
            <h3>Results</h3>
            <p>Your score so far and the list of questions you missed, ready to repeat.</p>
          </article>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
