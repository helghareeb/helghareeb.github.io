---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import FlashcardSession from '../../../../../../components/FlashcardSession.astro';
import '../../../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../../../utils/seo';
import { getDeckRouteSlug, serializeFlashcards } from '../../../../../../utils/flashcards';

export async function getStaticPaths() {
  const decks = await getCollection('flashcardDecks');

  return decks
    .filter((entry) => entry.data.lang === 'en' && !entry.data.draft)
    .map((entry) => ({
      params: { book: entry.slug.replace(/-(ar|en)$/, '') },
      props: { deck: entry },
    }));
}

const { deck } = Astro.props as { deck: CollectionEntry<'flashcardDecks'> };
const cards = (await getCollection('flashcards'))
  .filter(
    (entry) =>
      entry.data.lang === 'en' &&
      !entry.data.draft &&
      entry.data.deckSlug === getDeckRouteSlug(deck.slug) &&
      (entry.data.mode === 'training' || entry.data.mode === 'test'),
  )
  .sort((a, b) => a.data.order - b.data.order);
const seoTitle = buildSeoTitle(`Results ${deck.data.bookTitle}`, {
  lang: 'en',
  section: 'Flashcards',
});
const seoDescription = buildSeoDescription(deck.data.summary, ['Results and missed questions']);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Results</p>
      <h1 class="hero__title">Results for {deck.data.bookTitle}</h1>
      <p class="hero__lead">
        Your score in training and test mode, and the questions you missed, saved in your browser.
      </p>
    </section>

    {cards.length === 0 ? (
      <section class="shell section">
        <article class="notice-card">
          <h2 class="section-title">These flashcards are in Arabic</h2>
          <p>
            The questions and answers for {deck.data.bookTitle} are written in Arabic.
            <a href={`/ar/study/flashcards/${deck.slug.replace(/-(ar|en)$/, '')}/results/`}>Open the results page in Arabic</a>.
          </p>
        </article>
      </section>
    ) : (
      <FlashcardSession
        lang="en"
        deckSlug={getDeckRouteSlug(deck.slug)}
        mode="results"
        cards={serializeFlashcards(cards)}
      />
    )}
  </main>
</BaseLayout>
