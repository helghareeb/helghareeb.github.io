---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import FlashcardSession from '../../../../../../components/FlashcardSession.astro';
import '../../../../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../../../../utils/seo';
import { getDeckRouteSlug, serializeFlashcards } from '../../../../../../utils/flashcards';

export async function getStaticPaths() {
  const decks = await getCollection('flashcardDecks');

  return decks
    .filter((entry) => entry.data.lang === 'en' && !entry.data.draft)
    .map((entry) => ({
      params: { book: entry.slug.replace(/-(ar|en)$/, '') },
      props: { deck: entry },
    }));
}

const { deck } = Astro.props as { deck: CollectionEntry<'flashcardDecks'> };
const cards = (await getCollection('flashcards'))
  .filter(
    (entry) =>
      entry.data.lang === 'en' &&
      !entry.data.draft &&
      entry.data.deckSlug === getDeckRouteSlug(deck.slug) &&
      entry.data.mode === 'test',
  )
  .sort((a, b) => a.data.order - b.data.order);
const seoTitle = buildSeoTitle(`Test ${deck.data.bookTitle}`, {
  lang: 'en',
  section: 'Flashcards',
});
const seoDescription = buildSeoDescription(deck.data.summary, [`${cards.length} test questions`]);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Test</p>
      <h1 class="hero__title">Test mode for {deck.data.bookTitle}</h1>
      <p class="hero__lead">
        This mode presents the questions as an assessment, so you can measure what you have retained.
      </p>
    </section>

    <section class="shell section">
      {cards.length === 0 ? (
        <article class="notice-card">
          <h2 class="section-title">These flashcards are in Arabic</h2>
          <p>
            The questions and answers for {deck.data.bookTitle} are written in Arabic.
            <a href={`/ar/study/flashcards/${deck.slug.replace(/-(ar|en)$/, '')}/test/`}>Open the test questions in Arabic</a>.
          </p>
        </article>
      ) : (
        <FlashcardSession
          lang="en"
          deckSlug={getDeckRouteSlug(deck.slug)}
          mode="test"
          cards={serializeFlashcards(cards)}
        />
      )}
    </section>
  </main>
</BaseLayout>
