---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/global.css';
import { getEntryPath, getEntryRouteSlug } from '../../../../utils/content-routing';
import { buildSeoDescription, buildSeoTitle } from '../../../../utils/seo';

const decks = (await getCollection('flashcardDecks')).filter(
  (entry) => entry.data.lang === 'en' && !entry.data.draft,
);
const englishCards = (await getCollection('flashcards')).filter((entry) => entry.data.lang === 'en' && !entry.data.draft);
const countFor = (deckSlug: string) => englishCards.filter((card) => card.data.deckSlug === deckSlug).length;
const totalQuestions = decks.reduce((sum, deck) => sum + countFor(getEntryRouteSlug(deck.slug)), 0);

const seoTitle = buildSeoTitle('Flashcards', {
  lang: 'en',
  section: 'Study Hub',
});
const seoDescription = buildSeoDescription(
  'Flashcards for review, training and testing on Akhsar al-Mukhtasarat, the concise Hanbali fiqh primer.',
  [`${totalQuestions} questions`],
);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--detail">
      <p class="hero__eyebrow">Flashcards</p>
      <h1 class="hero__title">Flashcards</h1>
      <p class="hero__lead">
        Revision questions on Akhsar al-Mukhtasarat, the concise primer of Hanbali fiqh. The questions
        and answers are also available in the <a href="/ar/study/flashcards/">original Arabic</a>.
      </p>
    </section>

    <section class="shell entity-meta-grid">
      <article class="content-card entity-card">
        <p class="content-card__meta">Mode one</p>
        <h3>Review</h3>
        <p>Read each question together with its answer to fix the core material.</p>
      </article>
      <article class="content-card entity-card">
        <p class="content-card__meta">Mode two</p>
        <h3>Training</h3>
        <p>See the question first, try to recall the answer, then reveal it and mark yourself.</p>
      </article>
      <article class="content-card entity-card">
        <p class="content-card__meta">Mode three</p>
        <h3>Test</h3>
        <p>Answer as an assessment; the results page then lists the questions you missed.</p>
      </article>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Decks</p>
        <h2 class="section-title">Available decks</h2>
      </div>

      <div class="grid-two">
        {decks.map((deck) => (
          <a class="card-link" href={getEntryPath('flashcardDecks', 'en', deck.slug)}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{deck.data.field} · {countFor(getEntryRouteSlug(deck.slug))} questions</p>
              <h3>{deck.data.bookTitle}</h3>
              <p>{deck.data.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
