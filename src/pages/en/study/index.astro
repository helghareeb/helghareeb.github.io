---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/global.css';
import { buildSeoDescription, buildSeoTitle } from '../../../utils/seo';
import { getStudyBenefitBookPath, groupStudyBenefits } from '../../../utils/study';

const benefits = (await getCollection('studyBenefits')).filter(
  (entry) => entry.data.lang === 'en' && !entry.data.draft,
);
const benefitGroups = groupStudyBenefits(benefits);

const books = new Map<string, { title: string; teachers: Map<string, string> }>();

for (const group of benefitGroups) {
  const book = books.get(group.bookTitle) ?? { title: group.bookTitle, teachers: new Map<string, string>() };
  if (group.teacher && !book.teachers.has(group.teacher)) {
    book.teachers.set(group.teacher, getStudyBenefitBookPath('en', group.fieldSlug, group.bookSlug));
  }
  books.set(group.bookTitle, book);
}

const flashcardCount = (await getCollection('flashcards')).filter(
  (entry) => entry.data.lang === 'en' && !entry.data.draft && entry.data.deckSlug === 'akhsar-al-mukhtasarat',
).length;

const tracks = [
  {
    eyebrow: `${benefits.length} notebooks`,
    title: 'Benefits from Books',
    href: '/en/study/benefits/',
    summary: "Edited notes from lessons on al-Shafi'i's al-Risalah and al-Tabari's commentary on al-Fatihah and al-Baqarah, arranged by subject and teacher.",
  },
  {
    eyebrow: `${flashcardCount} questions`,
    title: 'Flashcards',
    href: '/en/study/flashcards/',
    summary: 'Review, training and test questions on Akhsar al-Mukhtasarat in Hanbali fiqh, with a results page for the questions you missed.',
  },
];

const seoTitle = buildSeoTitle('Study Hub', {
  lang: 'en',
  section: 'Dr. Haitham A. El-Ghareeb',
});
const seoDescription = buildSeoDescription(
  "Study notes on al-Shafi'i's al-Risalah and al-Tabari's Tafsir, and flashcards on Akhsar al-Mukhtasarat, for students of Islamic knowledge.",
  [`${benefits.length} notebooks`, `${flashcardCount} flashcards`],
);
---

<BaseLayout lang="en" dir="ltr" title={seoTitle} description={seoDescription}>
  <main class="page-main">
    <section class="shell hero hero--portal">
      <p class="hero__eyebrow">Study Hub</p>
      <h1 class="hero__title">Study Hub</h1>
      <p class="hero__lead">
        Notes and revision questions for students of Islamic knowledge, drawn from lessons on
        al-Shafi'i's al-Risalah, al-Tabari's Tafsir and Akhsar al-Mukhtasarat.
      </p>

      <div class="hero__actions">
        <a class="button-secondary" href="/en/learning-path/">Suggested learning path</a>
      </div>
    </section>

    <section class="shell section">
      <div class="grid-two">
        {tracks.map((track) => (
          <a class="card-link" href={track.href}>
            <article class="content-card entity-card">
              <p class="content-card__meta">{track.eyebrow}</p>
              <h3>{track.title}</h3>
              <p>{track.summary}</p>
            </article>
          </a>
        ))}
      </div>
    </section>

    <section class="shell section">
      <div class="section-heading">
        <p class="section-kicker">Books covered</p>
        <h2 class="section-title">Books and teachers</h2>
      </div>

      <div class="grid-two">
        {Array.from(books.values()).map((book) => (
          <article class="content-card entity-card">
            <h3>{book.title}</h3>
            <ul class="list-clean">
              {Array.from(book.teachers.entries()).map(([teacher, href]) => (
                <li><a href={href}>{teacher}</a></li>
              ))}
            </ul>
          </article>
        ))}
        <a class="card-link" href="/en/study/flashcards/">
          <article class="content-card entity-card">
            <h3>Akhsar al-Mukhtasarat</h3>
            <p>Flashcards on this concise primer of Hanbali fiqh.</p>
          </article>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
