---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title="الموقع الشخصي العلمي | د. هيثم الغريب"
  description="الموقع العلمي للدكتور هيثم عبدالمنعم الغريب: مؤلفات وتحقيقات ومقالات ومواد مذاكرة، وسيرته في نظم المعلومات بجامعة المنصورة."
>
  <main class="page-main">
    <section class="shell hero">
      <p class="hero__eyebrow">مرحبًا بكم · Welcome</p>
      <h1 class="hero__title">الموقع الشخصي العلمي للدكتور هيثم الغريب</h1>
      <p class="hero__lead">
        مؤلفات الدكتور هيثم عبدالمنعم الغريب وتحقيقاته ومقالاته، ومواد المذاكرة لطالب العلم،
        وسيرته العلمية أستاذًا لنظم المعلومات بجامعة المنصورة.
      </p>

      <div class="hero__actions">
        <a class="button" href="/ar/">الدخول إلى النسخة العربية</a>
        <a class="button-secondary" href="/en/">Enter the English version</a>
      </div>
    </section>
  </main>
</BaseLayout>
